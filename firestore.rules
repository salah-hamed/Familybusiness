     || ownsProject(supermarketId)
     || isProjectOperator(supermarketId)
     || supermarketPartnerReady(supermarketId);

    allow create: if (
       isAdmin()
       || isProjectOperator(supermarketId)
      )
      && request.resource.data.productId == productId
      && request.resource.data.projectId == supermarketId
      && request.resource.data.name is string
      && request.resource.data.name.size() > 0
      && request.resource.data.category is string
      && request.resource.data.price is number
      && request.resource.data.price >= 0
      && request.resource.data.inStock is bool
      && request.resource.data.isActive is bool
      && request.resource.data.barcode is string
