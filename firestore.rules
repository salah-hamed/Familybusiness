rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function userPath(uid){ return /databases/$(database)/documents/users/$(uid); }
  function projectPath(projectId){ return /databases/$(database)/documents/projects/$(projectId); }
  function carwashSubscriptionPath(subscriptionId){ return /databases/$(database)/documents/carwashSubscriptions/$(subscriptionId); }
  function operatorPath(operatorId){ return /databases/$(database)/documents/operators/$(operatorId); }
  function commissionAgreementPath(agreementId){ return /databases/$(database)/documents/commissionAgreements/$(agreementId); }
  function workerPath(workerId){ return /databases/$(database)/documents/workers/$(workerId); }
  function orderPath(orderId){ return /databases/$(database)/documents/orders/$(orderId); }
  function orderTrackingPath(trackingToken){ return /databases/$(database)/documents/orderTracking/$(trackingToken); }
  function supermarketPath(projectId){ return /databases/$(database)/documents/supermarkets/$(projectId); }
  function restaurantPath(projectId){ return /databases/$(database)/documents/restaurants/$(projectId); }
  function laundryPath(projectId){ return /databases/$(database)/documents/laundries/$(projectId); }
  function commissionLedgerPath(entryId){ return /databases/$(database)/documents/commissionLedger/$(entryId); }
  function commissionReversalPath(reversalId){ return /databases/$(database)/documents/commissionReversals/$(reversalId); }
  function subscriptionPaymentPath(paymentId){ return /databases/$(database)/documents/subscriptionPayments/$(paymentId); }
  function billingGuardPath(uid){ return /databases/$(database)/documents/subscriptionBillingGuards/$(uid); }
  function commissionSettlementPath(settlementId){ return /databases/$(database)/documents/commissionSettlements/$(settlementId); }
  function merchantViolationPath(projectId){ return /databases/$(database)/documents/merchantViolations/$(projectId); }
  function merchantRecoveryPath(projectId){ return /databases/$(database)/documents/merchantRecoveries/$(projectId); }
  function merchantTransferCasePath(projectId){ return /databases/$(database)/documents/merchantTransferCases/$(projectId); }
  function merchantTransferFinanceReviewPath(projectId){ return /databases/$(database)/documents/merchantTransferFinanceReviews/$(projectId); }
  function merchantCutoverPath(projectId){ return /databases/$(database)/documents/merchantAssignmentCutovers/$(projectId); }
  function merchantRecoveryCyclePath(id){ return /databases/$(database)/documents/merchantRecoveryCycles/$(id); }
  function merchantAssignmentCyclePath(id){ return /databases/$(database)/documents/merchantAssignmentCycles/$(id); }
  function merchantTransferCyclePath(id){ return /databases/$(database)/documents/merchantTransferCycles/$(id); }
  function merchantHistoricGrantPath(id){ return /databases/$(database)/documents/merchantHistoricalAccess/$(id); }
  function merchantTransferCycleFinanceReviewPath(id){ return /databases/$(database)/documents/merchantTransferCycleFinanceReviews/$(id); }
  function subscriptionGrantPath(grantId){ return /databases/$(database)/documents/subscriptionGrants/$(grantId); }
  function platformCounterPath(counterId){ return /databases/$(database)/documents/platformCounters/$(counterId); }
  function userExists(uid){ return exists(userPath(uid)); }
  function userData(uid){ return get(userPath(uid)).data; }
  function isAdmin(){ return signedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == "admin"; }
  function subscriptionActive(uid){
   let user = userData(uid);
   return userExists(uid)
    && user.isActive == true
    && (
      (
        user.subscriptionStatus == "active"
        && (!("subscriptionExpiresAt" in user) || user.subscriptionExpiresAt > request.time)
        && (
          !("accessModel" in user) || user.accessModel != "merchant_trial_v1"
          || (
            ("subscriptionExpiresAt" in user)
            && (
              user.initialActivationPaid == true
              || ("lastSubscriptionPaymentId" in user && user.lastSubscriptionPaymentId is string)
              || ("lastActivationSource" in user && user.lastActivationSource == "launch_promo")
            )
          )
        )
      )
      || (
        ("accessModel" in user)
        && user.accessModel == "merchant_trial_v1"
        && user.subscriptionStatus == "trial"
        && user.initialActivationPaid == false
        && !("lastSubscriptionPaymentId" in user)
        && user.createdAt is timestamp
        && user.createdAt <= request.time
        && (
          (
            user.firstMerchantLinkedAt == null
            && request.time < user.createdAt + duration.value(7, 'd')
          )
          || (
            user.firstMerchantLinkedAt is timestamp
            && user.firstMerchantLinkedAt >= user.createdAt
            && user.firstMerchantLinkedAt <= request.time
            && request.time < user.firstMerchantLinkedAt + duration.value(3, 'd')
          )
        )
      )
    );
  }
  function projectExists(projectId){ return exists(projectPath(projectId)); }
  function projectData(projectId){ return get(projectPath(projectId)).data; }
  function isVerifiedPlatformManagedMerchant(projectId){
   let p = projectData(projectId);
   return (("assignmentCycle" in p) && p.assignmentCycle is int
     && p.assignmentCycle>=2)
     ? verifiedRepeatPlatformMerchant(projectId)
     : (projectExists(projectId)
    && ("platformManaged" in p) && p.platformManaged == true
    && p.template in ["supermarket","restaurant","bakery","laundry"]
    && p.operatingModel == "partner_operated"
    && p.assignmentStatus == "platform_managed"
    && p.assignedSubscriberId == ""
    && p.recoveryAuditId == projectId
    && p.recoveryAt is timestamp
    && p.recoveryAdminUid is string
    && exists(merchantRecoveryPath(projectId))
    && get(merchantRecoveryPath(projectId)).data.status == "completed"
    && get(merchantRecoveryPath(projectId)).data.recoveredAt == p.recoveryAt
    && get(merchantRecoveryPath(projectId)).data.adminUid == p.recoveryAdminUid
    && get(merchantRecoveryPath(projectId)).data.previousSubscriberId == p.originalSubscriberId
    && get(merchantRecoveryPath(projectId)).data.merchantId == p.merchantId);
  }
  // Live assignment is legal only after BOTH the consent and audit documents exist.
  // Read EACH referenced document once. Ledger creation and order update
  // share a limited Rules expression/read budget, even in a batch.
  function cutoverDocumentsMatch(projectId,p){
   let c = get(merchantTransferCasePath(projectId)).data;
   let a = get(merchantCutoverPath(projectId)).data;
   return c.status == "cutover_completed"
    && c.projectDocId == projectId
    && c.merchantId == p.merchantId
    && c.originalSubscriberId == p.originalSubscriberId
    && c.proposedSubscriberId == p.assignedSubscriberId
    && c.operatorConsent == "accepted"
    && c.recipientConsent == "accepted"
    && c.financeClearance == "reviewed"
    && c.cutoverAt == p.cutoverAt
    && c.cutoverBy == p.cutoverAdminUid
    && a.status == "completed"
    && a.projectDocId == projectId
    && a.merchantId == p.merchantId
    && a.originalSubscriberId == p.originalSubscriberId
    && a.assignedSubscriberId == p.assignedSubscriberId
    && a.completedAt == p.cutoverAt
    && a.completedBy == p.cutoverAdminUid;
  }
  function isVerifiedAssignedAfterCutover(projectId){
   let p = projectData(projectId);
   return (("assignmentCycle" in p) && p.assignmentCycle is int
     && p.assignmentCycle>=2)
     ? verifiedRepeatAssignedMerchant(projectId)
     : (projectExists(projectId)
    && ("platformManaged" in p) && p.platformManaged == true
    && ("assignmentStatus" in p) && p.assignmentStatus == "assigned_to_new_subscriber"
    && p.assignedSubscriberId is string
    && p.assignedSubscriberId.size() > 0
    && p.assignedSubscriberId != p.originalSubscriberId
    && p.cutoverAuditId == projectId
    && p.cutoverAt is timestamp
    && p.cutoverAdminUid is string
    && p.recoveryAuditId == projectId
    && exists(merchantTransferCasePath(projectId))
    && exists(merchantCutoverPath(projectId))
    && cutoverDocumentsMatch(projectId,p));
  }
  // C4B12: v2+ epoch witnesses are isolated from immutable C4B11 records.
  function verifiedRepeatPlatformMerchant(projectId){
    let p=projectData(projectId);
    return ("assignmentCycle" in p) && p.assignmentCycle is int
     && p.assignmentCycle>=2
     && p.recoveryAuditId==projectId+"_"+string(p.assignmentCycle)
     && exists(merchantRecoveryCyclePath(p.recoveryAuditId))
     && repeatPlatformEvidence(projectId,p);
  }
  function repeatPlatformEvidence(projectId,p){
    let a=get(merchantRecoveryCyclePath(p.recoveryAuditId)).data;
    return p.platformManaged==true && p.assignmentStatus=="platform_managed"
     && p.assignedSubscriberId==""
     && p.recoveryAt is timestamp && p.recoveryAdminUid is string
     && a.status=="completed" && a.cycle==p.assignmentCycle
     && a.cycleId==p.recoveryAuditId && a.projectDocId==projectId
     && a.merchantId==p.merchantId
     && a.originalSubscriberId==p.originalSubscriberId
     && a.recoveredAt==p.recoveryAt && a.adminUid==p.recoveryAdminUid;
  }
  function verifiedRepeatAssignedMerchant(projectId){
    let p=projectData(projectId);
    return ("assignmentCycle" in p) && p.assignmentCycle is int
     && p.assignmentCycle>=2
     && p.cutoverAuditId==projectId+"_"+string(p.assignmentCycle)
     && p.recoveryAuditId==p.cutoverAuditId
     && exists(merchantRecoveryCyclePath(p.recoveryAuditId))
     && exists(merchantAssignmentCyclePath(p.cutoverAuditId))
     && repeatAssignmentEvidence(projectId,p);
  }
  function repeatAssignmentEvidence(projectId,p){
    let a=get(merchantAssignmentCyclePath(p.cutoverAuditId)).data;
    // Consent and accepted terms are validated when creating this immutable
    // witness. Runtime dispatch only needs the signed epoch beneficiary.
    return p.platformManaged==true
     && p.assignmentStatus=="assigned_to_new_subscriber"
     && p.assignedSubscriberId is string && p.assignedSubscriberId.size()>0
     && p.assignedSubscriberId!=p.originalSubscriberId
     && p.cutoverAt is timestamp && p.cutoverAdminUid is string
     && a.status=="completed" && a.cycle==p.assignmentCycle
     && a.cycleId==p.cutoverAuditId && a.projectDocId==projectId
     && a.merchantId==p.merchantId
     && a.originalSubscriberId==p.originalSubscriberId
     && a.recoveryAuditId==p.recoveryAuditId
     && a.assignedSubscriberId==p.assignedSubscriberId
     && a.completedAt==p.cutoverAt && a.completedBy==p.cutoverAdminUid;
  }
  function historicCycleStatementAccess(projectId){
    let path=merchantHistoricGrantPath(projectId+"_"+request.auth.uid);
    return signedIn() && exists(path)
     && get(path).data.projectDocId==projectId
     && get(path).data.subscriberUid==request.auth.uid
     && get(path).data.merchantId==projectData(projectId).merchantId
     && get(path).data.status=="historic_only";
  }
  function currentAssignedSubscriber(projectId){
   return signedIn() && isVerifiedAssignedAfterCutover(projectId)
    && projectData(projectId).assignedSubscriberId == request.auth.uid
    && subscriptionActive(request.auth.uid);
  }
  function historicProjectOwner(projectId){
   return signedIn() && projectExists(projectId)
    && projectData(projectId).ownerId == request.auth.uid;
  }
  function ownsProject(projectId){
   return currentAssignedSubscriber(projectId)
    || (historicProjectOwner(projectId)
      && (!("platformManaged" in projectData(projectId))
       || projectData(projectId).platformManaged == false));
  }
  function commissionBeneficiary(projectId){
   let p=projectData(projectId);
   // Choose the one live state FIRST. Verifying a non-applicable audit
   // can exhaust Firestore's rule-evaluation budget in rider dispatch.
   return !("platformManaged" in p) || p.platformManaged==false
    ? ((("assignedSubscriberId" in p) && p.assignedSubscriberId!=p.ownerId)
       ? "" : p.ownerId)
    : (p.assignmentStatus=="platform_managed"
       ? (isVerifiedPlatformManagedMerchant(projectId)
          ? "__fb_platform_commissions__" : "")
       : (p.assignmentStatus=="assigned_to_new_subscriber"
         ? (isVerifiedAssignedAfterCutover(projectId) ? p.assignedSubscriberId : "")
         : ""));
  }
  function projectAvailable(projectId){
   let project = projectData(projectId);
   return projectExists(projectId)
    && project.isActive == true
    && project.status == "active"
    && ((("platformManaged" in project) && project.platformManaged == true
        && (isVerifiedPlatformManagedMerchant(projectId)
        || isVerifiedAssignedAfterCutover(projectId)))
        || ((!('platformManaged' in project) || project.platformManaged == false)
            && subscriptionActive(project.ownerId)));
  }
  function carwashSubscriptionExists(subscriptionId){ return exists(carwashSubscriptionPath(subscriptionId)); }
  function carwashSubscriptionData(subscriptionId){ return get(carwashSubscriptionPath(subscriptionId)).data; }
  function operatorExists(operatorId){ return exists(operatorPath(operatorId)); }
  function operatorData(operatorId){ return get(operatorPath(operatorId)).data; }
  function isOperator(operatorId){ return signedIn() && operatorExists(operatorId) && operatorData(operatorId).authUid == request.auth.uid; }
  function workerExists(workerId){ return exists(workerPath(workerId)); }
  function workerData(workerId){ return get(workerPath(workerId)).data; }
  function orderExists(orderId){ return exists(orderPath(orderId)); }
  function orderData(orderId){ return get(orderPath(orderId)).data; }
  function commissionAgreementExists(agreementId){ return exists(commissionAgreementPath(agreementId)); }
  function commissionAgreementData(agreementId){ return get(commissionAgreementPath(agreementId)).data; }
  function projectOrderLedgerAfterMatches(orderId, projectId, amount, version){
   let ledger = getAfter(commissionLedgerPath("project_order_" + orderId)).data;
   return ledger.orderId == orderId
    && ledger.projectId == projectId
    && ledger.amount == amount
    && ledger.agreementVersion == version;
  }
  function projectOrderLedgerExistsMatches(orderId, projectId, amount, version){
   return exists(commissionLedgerPath("project_order_" + orderId))
    && get(commissionLedgerPath("project_order_" + orderId)).data.orderId == orderId
    && get(commissionLedgerPath("project_order_" + orderId)).data.projectId == projectId
    && get(commissionLedgerPath("project_order_" + orderId)).data.amount == amount
    && get(commissionLedgerPath("project_order_" + orderId)).data.agreementVersion == version;
  }
  function validCommissionTriggerState(order){
   return (
      order.templateType in ["supermarket","restaurant","bakery"]
      && (
        (order.status == "assigned" && order.assignedWorkerRole == "rider")
        || order.status == "delivered"
      )
    )
    || (
      order.templateType == "laundry"
      && (
        (
          order.status == "accepted"
          && order.laundryStage == "out_for_delivery"
          && order.assignedWorkerRole == "delivery_agent"
        )
        || (
          order.status == "done"
          && order.laundryStage == "delivered"
        )
      )
    );
  }
  function commissionCycleMatches(order,ledger){
    let p=projectData(ledger.projectId);
    return (("assignmentCycle" in p) && p.assignmentCycle is int
        && p.assignmentCycle>=2)
      ? ("assignmentCycle" in ledger
        && ledger.assignmentCycle==p.assignmentCycle
        && ("commissionAssignmentCycle" in order)
        && order.commissionAssignmentCycle==p.assignmentCycle)
      : !("assignmentCycle" in ledger)
        && !("commissionAssignmentCycle" in order);
  }
  function validProjectOrderLedgerCreate(entryId){
   let ledger = request.resource.data;
   let order = getAfter(orderPath(ledger.orderId)).data;
   return signedIn()
    && !(order.templateType == "laundry" && ("trackingToken" in order))
    && ledger.sourceType == "project_order"
     && ledger.userId is string && ledger.userId.size()>0
    && ledger.projectId is string
    && ledger.orderId is string
    && entryId == "project_order_" + ledger.orderId
    && ledger.sourceId == ledger.orderId
    && ledger.agreementId == ledger.projectId
    && ledger.currency == "EGP"
    && ledger.status == "earned"
    && ledger.paidAt == null
    && projectExists(ledger.projectId)
    && commissionAgreementExists(ledger.projectId)
    && isProjectOperator(ledger.projectId)
    && projectData(ledger.projectId).template in ["supermarket","laundry","restaurant","bakery"]
    && commissionAgreementData(ledger.projectId).status == "accepted"
    && commissionAgreementData(ledger.projectId).currentAmount is number
    && ledger.userId == commissionBeneficiary(ledger.projectId)
    && ledger.amount == commissionAgreementData(ledger.projectId).currentAmount
    && ledger.agreementVersion == commissionAgreementData(ledger.projectId).acceptedVersion
    && order.projectId == ledger.projectId
    && validCommissionTriggerState(order)
    && order.commissionLocked == true
    && order.commissionAmount == ledger.amount
    && order.commissionAgreementVersion == ledger.agreementVersion
    && commissionCycleMatches(order,ledger);
  }
  function validTrackedLaundryProjectOrderLedgerCreate(entryId){
   let ledger = request.resource.data;
   let order = getAfter(orderPath(ledger.orderId)).data;
   return signedIn()
    && ledger.sourceType == "project_order"
     && ledger.userId is string && ledger.userId.size()>0
    && ledger.projectId is string
    && ledger.orderId is string
    && entryId == "project_order_" + ledger.orderId
    && ledger.sourceId == ledger.orderId
    && ledger.agreementId == ledger.projectId
    && ledger.currency == "EGP"
    && ledger.status == "earned"
    && ledger.paidAt == null
    && order.templateType == "laundry"
    && order.trackingToken is string
    && order.trackingToken.size() >= 40
    && order.projectId == ledger.projectId
    && order.status == "accepted"
    && order.laundryStage == "out_for_delivery"
    && order.commissionLocked == true
    && order.commissionAmount == ledger.amount
    && order.commissionAgreementVersion == ledger.agreementVersion
    && ledger.userId == commissionBeneficiary(ledger.projectId)
    && commissionCycleMatches(order,ledger)
    && isProjectOperator(ledger.projectId);
  }

  function validTrackedLaundryDispatchUpdate(orderId){
   let before = resource.data;
   let after = request.resource.data;
   let agreement = commissionAgreementData(before.projectId);
   let ledger = getAfter(commissionLedgerPath("project_order_" + orderId)).data;
   let tracking = getAfter(orderTrackingPath(before.trackingToken)).data;
   return signedIn()
    && before.templateType == "laundry"
    && before.trackingToken is string
    && before.trackingToken.size() >= 40
    && isProjectOperator(before.projectId)
    && before.status == "accepted"
    && before.laundryStage == "ready_delivery"
    && before.assignedWorkerId is string
    && before.assignedWorkerId.size() > 0
    && before.assignedWorkerRole == "delivery_agent"
    && after.projectId == before.projectId
    && after.providerId == before.providerId
    && after.trackingToken == before.trackingToken
    && after.status == "accepted"
    && after.laundryStage == "out_for_delivery"
    && after.statusUpdatedBy == request.auth.uid
    && agreement.status == "accepted"
    && agreement.currentAmount is number
    && agreement.acceptedVersion is number
    && after.commissionEligible == true
    && after.commissionLocked == true
    && after.commissionAmount == agreement.currentAmount
    && after.commissionAgreementVersion == agreement.acceptedVersion
    && after.commissionTrigger == "delivery_assignment"
    && after.commissionEarnedAt == request.time
    && after.diff(before).affectedKeys().hasOnly([
      "status",
      "laundryStage",
      "statusUpdatedAt",
      "statusUpdatedBy",
      "commissionEligible",
      "commissionLocked",
      "commissionAmount",
      "commissionAgreementVersion",
      "commissionTrigger",
      "commissionEarnedAt",
       "commissionAssignmentCycle"
    ])
    && ledger.orderId == orderId
    && ledger.projectId == before.projectId
    && ledger.amount == after.commissionAmount
    && ledger.agreementVersion == after.commissionAgreementVersion
    && tracking.trackingToken == before.trackingToken
    && tracking.orderId == orderId
    && tracking.projectId == before.projectId
    && tracking.templateType == "laundry"
    && tracking.status == "out_for_delivery";
  }

  function validTrackedLaundryDeliveryUpdate(orderId){
   let before = resource.data;
   let after = request.resource.data;
   let ledger = get(commissionLedgerPath("project_order_" + orderId)).data;
   let tracking = getAfter(orderTrackingPath(before.trackingToken)).data;
   return signedIn()
    && before.templateType == "laundry"
    && before.trackingToken is string
    && before.trackingToken.size() >= 40
    && isProjectOperator(before.projectId)
    && before.status == "accepted"
    && before.laundryStage == "out_for_delivery"
    && before.commissionEligible == true
    && before.commissionLocked == true
    && before.commissionAmount is number
    && before.commissionAgreementVersion is number
    && after.projectId == before.projectId
    && after.providerId == before.providerId
    && after.trackingToken == before.trackingToken
    && after.status == "done"
    && after.laundryStage == "delivered"
    && after.statusUpdatedBy == request.auth.uid
    && after.commissionEligible == before.commissionEligible
    && after.commissionLocked == before.commissionLocked
    && after.commissionAmount == before.commissionAmount
    && after.commissionAgreementVersion == before.commissionAgreementVersion
    && after.diff(before).affectedKeys().hasOnly([
      "status","laundryStage","statusUpdatedAt","statusUpdatedBy","deliveredAt"
    ])
    && ledger.orderId == orderId
    && ledger.projectId == before.projectId
    && ledger.amount == before.commissionAmount
    && ledger.agreementVersion == before.commissionAgreementVersion
    && tracking.trackingToken == before.trackingToken
    && tracking.orderId == orderId
    && tracking.projectId == before.projectId
    && tracking.templateType == "laundry"
    && tracking.status == "delivered";
  }

  function validDispatchCommissionUpdate(orderId){
   let before = resource.data;
   let after = request.resource.data;
   return signedIn()
    && (isAdmin() || isProjectOperator(before.projectId))
    && after.projectId == before.projectId
    && after.providerId == before.providerId
    && after.statusUpdatedBy == request.auth.uid
    && after.commissionEligible == true
    && after.commissionLocked == true
    && after.commissionAmount is number
    && after.commissionAgreementVersion is number
    && after.commissionTrigger == "delivery_assignment"
    && after.commissionEarnedAt == request.time
    && projectOrderLedgerAfterMatches(
      orderId,
      before.projectId,
      after.commissionAmount,
      after.commissionAgreementVersion
    )
    && (
      (
        before.templateType in ["supermarket","restaurant","bakery"]
        && before.status == "ready"
        && after.status == "assigned"
        && before.pricingLocked == true
        && after.assignedWorkerId is string
        && after.assignedWorkerId.size() > 0
        && after.assignedWorkerRole == "rider"
        && workerExists(after.assignedWorkerId)
        && workerData(after.assignedWorkerId).projectId == before.projectId
        && workerData(after.assignedWorkerId).role == "rider"
        && after.diff(before).affectedKeys().hasOnly([
          "status",
          "statusUpdatedAt",
          "statusUpdatedBy",
          "commissionEligible",
          "commissionLocked",
          "commissionAmount",
          "commissionAgreementVersion",
          "commissionTrigger",
          "commissionEarnedAt",
       "commissionAssignmentCycle"
        ])
      )
      ||
      (
        before.templateType == "laundry"
        && before.status == "accepted"
        && before.laundryStage == "ready_delivery"
        && after.status == "accepted"
        && after.laundryStage == "out_for_delivery"
        && after.assignedWorkerId is string
        && after.assignedWorkerId.size() > 0
        && after.assignedWorkerRole == "delivery_agent"
        && workerExists(after.assignedWorkerId)
        && workerData(after.assignedWorkerId).projectId == before.projectId
        && workerData(after.assignedWorkerId).role == "delivery_agent"
        && after.diff(before).affectedKeys().hasOnly([
          "status",
          "laundryStage",
          "statusUpdatedAt",
          "statusUpdatedBy",
          "commissionEligible",
          "commissionLocked",
          "commissionAmount",
          "commissionAgreementVersion",
          "commissionTrigger",
          "commissionEarnedAt",
       "commissionAssignmentCycle"
        ])
      )
    );
  }
  function validLockedCommissionDeliveryUpdate(orderId){
   let before = resource.data;
   let after = request.resource.data;
   return signedIn()
    && (isAdmin() || isProjectOperator(before.projectId))
    && after.projectId == before.projectId
    && after.providerId == before.providerId
    && after.statusUpdatedBy == request.auth.uid
    && before.commissionEligible == true
    && before.commissionLocked == true
    && before.commissionAmount is number
    && before.commissionAgreementVersion is number
    && after.commissionEligible == before.commissionEligible
    && after.commissionLocked == before.commissionLocked
    && after.commissionAmount == before.commissionAmount
    && after.commissionAgreementVersion == before.commissionAgreementVersion
    && projectOrderLedgerExistsMatches(
      orderId,
      before.projectId,
      before.commissionAmount,
      before.commissionAgreementVersion
    )
    && (
      (
        before.templateType in ["supermarket","restaurant","bakery"]
        && before.status == "out_for_delivery"
        && after.status == "delivered"
        && before.pricingLocked == true
        && before.assignedWorkerId is string
        && before.assignedWorkerId.size() > 0
        && after.diff(before).affectedKeys().hasOnly([
          "status","statusUpdatedAt","statusUpdatedBy","deliveredAt"
        ])
      )
      ||
      (
        before.templateType == "laundry"
        && before.status == "accepted"
        && before.laundryStage == "out_for_delivery"
        && after.status == "done"
        && after.laundryStage == "delivered"
        && before.assignedWorkerId is string
        && before.assignedWorkerId.size() > 0
        && after.diff(before).affectedKeys().hasOnly([
          "status","laundryStage","statusUpdatedAt","statusUpdatedBy","deliveredAt"
        ])
      )
    );
  }
  function supermarketExists(projectId){ return exists(supermarketPath(projectId)); }
  function supermarketData(projectId){ return get(supermarketPath(projectId)).data; }
  function restaurantExists(projectId){ return exists(restaurantPath(projectId)); }
  function restaurantData(projectId){ return get(restaurantPath(projectId)).data; }
  function laundryExists(projectId){ return exists(laundryPath(projectId)); }
  function laundryData(projectId){ return get(laundryPath(projectId)).data; }
  function isLinkedProjectOperator(projectId){
   return signedIn()
    && projectExists(projectId)
    && projectData(projectId).operatorId is string
    && projectData(projectId).operatorId.size() > 0
    && operatorExists(projectData(projectId).operatorId)
    && operatorData(projectData(projectId).operatorId).authUid == request.auth.uid;
  }
  function linkedOperatorActive(operatorId){
    let op=operatorData(operatorId);
    return op.authUid==request.auth.uid
     && op.status=="active" && op.agreementStatus=="accepted"
     && op.isActive==true;
  }
  function isProjectOperator(projectId){
    let p=projectData(projectId);
    return signedIn()
     && projectExists(projectId)
     && p.operatingModel=="partner_operated"
     && p.operatorId is string && p.operatorId.size()>0
     && operatorExists(p.operatorId)
     && linkedOperatorActive(p.operatorId);
  }
  function canOperateProject(projectId){
   return isAdmin()
    || (
      signedIn()
      && projectExists(projectId)
      && projectData(projectId).operatingModel == "owner_operated"
      && projectData(projectId).ownerId == request.auth.uid
    )
    || isProjectOperator(projectId);
  }
  function validWorkerRoleForProject(projectId, role){
   return (
      projectData(projectId).template == "supermarket"
      && role == "rider"
    )
    || (
      projectData(projectId).template == "cleaning"
      && role == "cleaner"
    )
    || (
      projectData(projectId).template == "laundry"
      && role in ["pickup_agent","delivery_agent"]
    )
    || (
      projectData(projectId).template in ["restaurant","bakery"]
      && role == "rider"
    );
  }
  function supermarketPartnerReady(projectId){
   let project = projectData(projectId);
   let operator = operatorData(project.operatorId);
   let agreement = commissionAgreementData(projectId);
   return projectAvailable(projectId)
    && project.template == "supermarket"
    && project.operatingModel == "partner_operated"
    && project.operatorId is string
    && project.operatorId.size() > 0
    && operatorExists(project.operatorId)
    && operator.status == "active"
    && operator.agreementStatus == "accepted"
    && operator.isActive == true
    && commissionAgreementExists(projectId)
    && agreement.status == "accepted"
    && agreement.currentAmount is number
    && agreement.currentAmount >= 0
    && agreement.acceptedVersion is number
    && agreement.acceptedVersion > 0;
  }


  function restaurantPartnerReady(projectId){
   let project = projectData(projectId);
   let operator = operatorData(project.operatorId);
   let agreement = commissionAgreementData(projectId);
   return projectAvailable(projectId)
    && project.template in ["restaurant","bakery"]
    && project.operatingModel == "partner_operated"
    && project.operatorId is string
    && project.operatorId.size() > 0
    && operatorExists(project.operatorId)
    && operator.status == "active"
    && operator.agreementStatus == "accepted"
    && operator.isActive == true
    && commissionAgreementExists(projectId)
    && agreement.status == "accepted"
    && agreement.currentAmount is number
    && agreement.currentAmount >= 0
    && agreement.acceptedVersion is number
    && agreement.acceptedVersion > 0;
  }

  function trackingTemplateReady(projectId, templateType){
   return (
      templateType == "supermarket"
      && supermarketPartnerReady(projectId)
    )
    || (
      templateType in ["restaurant","bakery"]
      && restaurantPartnerReady(projectId)
    )
    || (
      templateType == "laundry"
      && laundryPartnerReady(projectId)
    );
  }

  function laundryTrackingStatus(order){
   return order.status == "new"
    ? "new"
    : order.status == "canceled"
      ? "canceled"
      : order.status == "done"
        ? "delivered"
        : order.laundryStage;
  }

  function validSupermarketTransition(fromStatus, toStatus){
   return (fromStatus == "new" && toStatus in ["accepted","canceled"])
    || (fromStatus == "accepted" && toStatus in ["preparing","canceled"])
    || (fromStatus == "preparing" && toStatus in ["ready","canceled"])
    || (fromStatus == "ready" && toStatus in ["assigned","canceled"])
    || (fromStatus == "assigned" && toStatus in ["out_for_delivery","canceled"])
    || (fromStatus == "out_for_delivery" && toStatus in ["delivered","canceled"]);
  }


  function laundryPartnerReady(projectId){
   let project = projectData(projectId);
   let operator = operatorData(project.operatorId);
   let agreement = commissionAgreementData(projectId);
   return projectAvailable(projectId)
    && project.template == "laundry"
    && project.operatingModel == "partner_operated"
    && project.operatorId is string
    && project.operatorId.size() > 0
    && operatorExists(project.operatorId)
    && operator.status == "active"
    && operator.agreementStatus == "accepted"
    && operator.isActive == true
    && commissionAgreementExists(projectId)
    && agreement.status == "accepted"
    && agreement.currentAmount is number
    && agreement.currentAmount >= 0
    && agreement.acceptedVersion is number
    && agreement.acceptedVersion > 0;
  }
  function laundryAcceptingOrders(projectId){
   let laundry = laundryData(projectId);
   return laundryPartnerReady(projectId)
    && laundryExists(projectId)
    && laundry.isAcceptingOrders == true;
  }

  function validLaundryTransition(fromStatus, fromStage, toStatus, toStage){
   return (
      fromStatus == "new"
      && (
        (toStatus == "accepted" && toStage == "accepted")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "accepted"
      && (
        (toStatus == "accepted" && toStage == "pickup_assigned")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "pickup_assigned"
      && (
        (toStatus == "accepted" && toStage == "picked_up")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "picked_up"
      && (
        (toStatus == "accepted" && toStage == "processing")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "processing"
      && (
        (toStatus == "accepted" && toStage == "ready_delivery")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "ready_delivery"
      && (
        (toStatus == "accepted" && toStage == "out_for_delivery")
        || toStatus == "canceled"
      )
    )
    || (
      fromStatus == "accepted"
      && fromStage == "out_for_delivery"
      && (
        (toStatus == "done" && toStage == "delivered")
        || toStatus == "canceled"
      )
    );
  }


  function validCustomerInput(){
   return request.resource.data.customerName is string
    && request.resource.data.customerName.size() > 0
    && request.resource.data.customerName.size() <= 100
    && request.resource.data.customerPhone is string
    && request.resource.data.customerPhone.size() > 0
    && request.resource.data.customerPhone.size() <= 30
    && request.resource.data.customerAddress is string
    && request.resource.data.customerAddress.size() > 0
    && request.resource.data.customerAddress.size() <= 500
    && request.resource.data.location is string
    && request.resource.data.location.size() <= 500
    && (!("notes" in request.resource.data)
      || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000));
  }

  // Legacy creates remain valid; new merchant assignments are immutable on create.
  function validInitialMerchantMetadata(){
   let data = request.resource.data;
   let fields = [
    "merchantId","originalSubscriberId","assignedSubscriberId",
    "assignmentStatus","platformManaged","linkedAt","assignmentUpdatedAt"
   ];
   return !data.keys().hasAny(fields)
    || (
     data.keys().hasAll(fields)
     && data.merchantId is string
     && data.merchantId.matches('^m_[0-9a-f]{32}$')
     && data.originalSubscriberId == request.auth.uid
     && data.assignedSubscriberId == request.auth.uid
     && data.assignmentStatus == "assigned_to_subscriber"
     && data.platformManaged == false
     && data.linkedAt == null
     && data.assignmentUpdatedAt == null
    );
  }

  function validActiveProjectCreate(projectDocId){
   let templateId = request.resource.data.projectId;
   return templateId in ["supermarket","restaurant","bakery","laundry"]
    && projectDocId == request.auth.uid + "_" + templateId
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.template == templateId
    && request.resource.data.operatingModel == "partner_operated"
    && (
      (templateId == "laundry" && request.resource.data.templateVersion == 3)
      || (templateId in ["supermarket","restaurant","bakery"] && request.resource.data.templateVersion == 1)
    )
    && request.resource.data.operatorId == ""
    && request.resource.data.partnerSetupStatus == "not_started"
    && request.resource.data.businessName is string
    && request.resource.data.businessName.size() > 0
    && request.resource.data.businessName.size() <= 120
    && request.resource.data.status == "active"
    && request.resource.data.isActive == true
    && request.resource.data.createdAt == request.time
    && request.resource.data.whatsappNumber is string
    && request.resource.data.whatsappNumber.size() <= 30
    && request.resource.data.instapayLink is string
    && request.resource.data.instapayLink.size() <= 500
    && request.resource.data.logo is string
    && request.resource.data.logo.size() <= 1000
    && request.resource.data.coverImage is string
    && request.resource.data.coverImage.size() <= 1000
    && request.resource.data.primaryColor is string
    && request.resource.data.primaryColor.size() <= 32
    && request.resource.data.priceConfig is map
    && request.resource.data.priceConfig.keys().hasOnly([])
    && validInitialMerchantMetadata()
    && request.resource.data.keys().hasOnly([
      "ownerId","projectId","template","operatingModel","templateVersion",
      "operatorId","partnerSetupStatus","businessName","status","isActive",
      "createdAt","whatsappNumber","instapayLink","logo","coverImage",
      "primaryColor","priceConfig",
      "merchantId","originalSubscriberId","assignedSubscriberId",
      "assignmentStatus","platformManaged","linkedAt","assignmentUpdatedAt"
    ]);
  }

  function validOrderTemplate(projectId){
   return request.resource.data.templateType is string
    && projectData(projectId).template == request.resource.data.templateType;
  }

  function validOrderEnvelope(projectId){
   return request.resource.data.projectId is string
    && request.resource.data.providerId == request.resource.data.projectId
    && request.resource.data.status == "new"
    && request.resource.data.createdAt == request.time
    && validOrderTemplate(projectId);
  }

  function validOrderByTemplate(projectId, templateType){
   return templateType == "supermarket"
    ? validSupermarketOrder(projectId)
    : templateType == "restaurant"
      ? validRestaurantOrder(projectId)
      : templateType == "bakery"
        ? validRestaurantOrder(projectId)
        : templateType == "laundry"
          ? (laundryAcceptingOrders(projectId) && validLaundryOrder(projectId))
          : templateType == "cleaning"
            ? validCleaningOrder(projectId)
            : templateType == "carwash"
              ? validCarwashOrder(projectId)
              : false;
  }

  function validCleaningOrder(projectId){
   let config = projectData(projectId).priceConfig;
   return request.resource.data.templateType == "cleaning"
    && projectAvailable(projectId)
    && validCustomerInput()
    && request.resource.data.rooms is number
    && request.resource.data.rooms >= 0
    && request.resource.data.bathrooms is number
    && request.resource.data.bathrooms >= 0
    && request.resource.data.kitchen in ["yes","no"]
    && request.resource.data.stairs in ["yes","no"]
    && request.resource.data.price is number
    && (
      (
       request.resource.data.kitchen == "no"
       && request.resource.data.stairs == "no"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
      )
      ||
      (
       request.resource.data.kitchen == "yes"
       && request.resource.data.stairs == "no"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.kitchen
      )
      ||
      (
       request.resource.data.kitchen == "no"
       && request.resource.data.stairs == "yes"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.stairs
      )
      ||
      (
       request.resource.data.kitchen == "yes"
       && request.resource.data.stairs == "yes"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.kitchen
         + config.stairs
      )
    );
  }

  function validCarwashOrder(projectId){
   let config = projectData(projectId).priceConfig;
   return request.resource.data.templateType == "carwash"
    && projectAvailable(projectId)
    && validCustomerInput()
    && request.resource.data.serviceType == "external_car_wash"
    && request.resource.data.planType == "monthly_new"
    && request.resource.data.subscriptionKey is string
    && request.resource.data.renewal is bool
    && request.resource.data.packageWashes is number
    && request.resource.data.price is number
    && ("monthly" in config)
    && ("monthlyWashes" in config)
    && config.monthly >= 0
    && config.monthlyWashes > 0
    && request.resource.data.price == config.monthly
    && request.resource.data.packageWashes == config.monthlyWashes;
  }

  function validLaundryItem(item, expectedKey, washPrice, ironPrice, washOnly){
   return item.key == expectedKey
    && item.quantity is number
    && item.quantity >= 0
    && item.quantity <= 100
    && item.unitPrice is number
    && item.subtotal is number
    && (
      (washOnly == true && item["service"] == "wash" && item.unitPrice == washPrice)
      ||
      (washOnly == false && (
       (item["service"] == "wash" && item.unitPrice == washPrice)
       || (item["service"] == "iron" && item.unitPrice == ironPrice)
       || (item["service"] == "wash_iron" && item.unitPrice == washPrice + ironPrice)
      ))
    )
    && item.subtotal == item.quantity * item.unitPrice;
  }

  function validLaundryOrder(projectId){
   let config = projectData(projectId).priceConfig;
   let items = request.resource.data.items;

   return request.resource.data.templateType == "laundry"
    && validCustomerInput()
    && request.resource.data.serviceType == "laundry_per_piece"
    && items is list
    && items.size() == 7
    && request.resource.data.totalPieces is number
    && request.resource.data.totalPieces > 0
    && request.resource.data.price is number
    && request.resource.data.trackingToken is string
    && request.resource.data.trackingToken.size() >= 40

    && items[0].key == "shirt"
    && (
      (items[0].quantity == 0 && items[0].subtotal == 0)
      || (items[0].quantity > 0 && validLaundryItem(items[0],"shirt",config.shirtWash,config.shirtIron,false))
    )

    && items[1].key == "trousers"
    && (
      (items[1].quantity == 0 && items[1].subtotal == 0)
      || (items[1].quantity > 0 && validLaundryItem(items[1],"trousers",config.trousersWash,config.trousersIron,false))
    )

    && items[2].key == "tshirt"
    && (
      (items[2].quantity == 0 && items[2].subtotal == 0)
      || (items[2].quantity > 0 && validLaundryItem(items[2],"tshirt",config.tshirtWash,config.tshirtIron,false))
    )

    && items[3].key == "dress"
    && (
      (items[3].quantity == 0 && items[3].subtotal == 0)
      || (items[3].quantity > 0 && validLaundryItem(items[3],"dress",config.dressWash,config.dressIron,false))
    )

    && items[4].key == "galabeya"
    && (
      (items[4].quantity == 0 && items[4].subtotal == 0)
      || (items[4].quantity > 0 && validLaundryItem(items[4],"galabeya",config.galabeyaWash,config.galabeyaIron,false))
    )

    && items[5].key == "suit"
    && (
      (items[5].quantity == 0 && items[5].subtotal == 0)
      || (items[5].quantity > 0 && validLaundryItem(items[5],"suit",config.suitWash,config.suitIron,false))
    )

    && items[6].key == "shoes"
    && (
      (items[6].quantity == 0 && items[6].subtotal == 0)
      || (items[6].quantity > 0 && validLaundryItem(items[6],"shoes",config.shoesWash,0,true))
    )

    && request.resource.data.totalPieces
      == items[0].quantity
       + items[1].quantity
       + items[2].quantity
       + items[3].quantity
       + items[4].quantity
       + items[5].quantity
       + items[6].quantity

    && request.resource.data.price
      == items[0].subtotal
       + items[1].subtotal
       + items[2].subtotal
       + items[3].subtotal
       + items[4].subtotal
       + items[5].subtotal
       + items[6].subtotal;
  }
  function validSupermarketOrder(projectId){
   return request.resource.data.templateType == "supermarket"
    && validCustomerInput()
    && request.resource.data.serviceType == "supermarket_delivery"
    && supermarketPartnerReady(projectId)
    && supermarketExists(projectId)
    && supermarketData(projectId).isAcceptingOrders == true
    && request.resource.data.customerName is string
    && request.resource.data.customerName.size() > 0
    && request.resource.data.customerPhone is string
    && request.resource.data.customerPhone.size() > 0
    && request.resource.data.customerAddress is string
    && request.resource.data.customerAddress.size() > 0
    && request.resource.data.location is string
    && request.resource.data.notes is string
    && request.resource.data.items is list
    && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 50
    && request.resource.data.subtotal is number
    && request.resource.data.subtotal >= 0
    && request.resource.data.deliveryFee is number
    && request.resource.data.deliveryFee == supermarketData(projectId).deliveryFee
    && request.resource.data.total is number
    && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee
    && request.resource.data.price == request.resource.data.total
    && request.resource.data.pricingLocked == false
    && request.resource.data.commissionEligible == false
    && request.resource.data.commissionLocked == false
    && request.resource.data.commissionAmount == 0
    && request.resource.data.trackingToken is string
    && request.resource.data.trackingToken.size() >= 40
    && request.resource.data.keys().hasOnly([
      "projectId",
      "providerId",
      "templateType",
      "serviceType",
      "status",
      "customerName",
      "customerPhone",
      "customerAddress",
      "location",
      "notes",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "price",
      "pricingLocked",
      "commissionEligible",
      "commissionLocked",
      "commissionAmount",
      "trackingToken",
      "createdAt"
    ]);
  }


  function validRestaurantOrder(projectId){
   return request.resource.data.templateType in ["restaurant","bakery"]
    && validCustomerInput()
    && request.resource.data.templateType == projectData(projectId).template
    && (
      (
        request.resource.data.templateType == "restaurant"
        && request.resource.data.serviceType == "restaurant_delivery"
      )
      || (
        request.resource.data.templateType == "bakery"
        && request.resource.data.serviceType == "bakery_delivery"
      )
    )
    && restaurantPartnerReady(projectId)
    && restaurantExists(projectId)
    && restaurantData(projectId).isAcceptingOrders == true
    && request.resource.data.customerName is string
    && request.resource.data.customerName.size() > 0
    && request.resource.data.customerPhone is string
    && request.resource.data.customerPhone.size() > 0
    && request.resource.data.customerAddress is string
    && request.resource.data.customerAddress.size() > 0
    && request.resource.data.location is string
    && request.resource.data.notes is string
    && request.resource.data.items is list
    && request.resource.data.items.size() > 0
    && request.resource.data.items.size() <= 50
    && request.resource.data.subtotal is number
    && request.resource.data.subtotal >= 0
    && request.resource.data.deliveryFee is number
    && request.resource.data.deliveryFee == restaurantData(projectId).deliveryFee
    && request.resource.data.total is number
    && request.resource.data.total == request.resource.data.subtotal + request.resource.data.deliveryFee
    && request.resource.data.price == request.resource.data.total
    && request.resource.data.pricingLocked == false
    && request.resource.data.commissionEligible == false
    && request.resource.data.commissionLocked == false
    && request.resource.data.commissionAmount == 0
    && request.resource.data.trackingToken is string
    && request.resource.data.trackingToken.size() >= 40
    && request.resource.data.keys().hasOnly([
      "projectId",
      "providerId",
      "templateType",
      "serviceType",
      "status",
      "customerName",
      "customerPhone",
      "customerAddress",
      "location",
      "notes",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "price",
      "pricingLocked",
      "commissionEligible",
      "commissionLocked",
      "commissionAmount",
      "trackingToken",
      "createdAt"
    ]);
  }


  match /users/{uid} {
   allow create: if signedIn()
    && request.auth.uid == uid
    && request.resource.data.uid == uid
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100
    && request.resource.data.email is string
    && request.resource.data.email.size() > 0
    && request.resource.data.email.size() <= 254
    && request.resource.data.projectType == ""
    && (
      (
        request.resource.data.isActive == false
        && request.resource.data.subscriptionStatus == "pending"
        && !request.resource.data.keys().hasAny(["accessModel","firstMerchantLinkedAt","firstMerchantProjectId"])
      )
      || (
        request.resource.data.isActive == true
        && request.resource.data.subscriptionStatus == "trial"
        && request.resource.data.accessModel == "merchant_trial_v1"
        && request.resource.data.firstMerchantLinkedAt == null
        && !("firstMerchantProjectId" in request.resource.data)
      )
    )
    && request.resource.data.initialActivationPaid == false
    && request.resource.data.billingCycle == "initial"
    && request.resource.data.referralQualified == false
    && request.resource.data.referredByUserId is string
    && request.resource.data.referredByUserId.size() <= 128
    && request.resource.data.referredByUserId != request.auth.uid
    && request.resource.data.createdAt == request.time
    && !("role" in request.resource.data)
    && request.resource.data.keys().hasOnly([
      "uid","name","email","projectType","isActive","subscriptionStatus",
      "initialActivationPaid","billingCycle","referredByUserId",
      "referralQualified","createdAt","accessModel","firstMerchantLinkedAt"
    ]);
   allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
   allow list: if isAdmin();
   allow update: if (
    isAdmin()
    && (
      (
        request.resource.data.isActive == false
        && request.resource.data.subscriptionStatus == "inactive"
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isActive","subscriptionStatus"
        ])
      )
      ||
      (
        request.resource.data.isActive == true
        && request.resource.data.subscriptionStatus == "active"
        && request.resource.data.initialActivationPaid == true
        && request.resource.data.billingCycle == "monthly"
        && request.resource.data.lastSubscriptionPaymentId is string
        && request.resource.data.lastSubscriptionPaymentId.size() > 0
        && request.resource.data.lastPaymentType in ["initial","renewal"]
        && request.resource.data.lastPaymentAmount is number
        && request.resource.data.lastPaymentAt == request.time
        && request.resource.data.subscriptionExpiresAt > request.time
        && existsAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId))
        && getAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId)).data.status == "approved"
        && getAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId)).data.userId == uid
        && getAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId)).data.paymentType == request.resource.data.lastPaymentType
        && getAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId)).data.amount == request.resource.data.lastPaymentAmount
        && getAfter(subscriptionPaymentPath(request.resource.data.lastSubscriptionPaymentId)).data.reviewedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isActive","subscriptionStatus","initialActivationPaid","billingCycle",
          "subscriptionStartedAt","subscriptionExpiresAt","lastPaymentAmount",
          "lastPaymentType","lastPaymentAt","lastSubscriptionPaymentId",
          "lastRenewalAt","activatedAt","referralQualified"
        ])
      )
      ||
      (
        request.resource.data.isActive == true
        && request.resource.data.subscriptionStatus == "active"
        && resource.data.initialActivationPaid == false
        && request.resource.data.initialActivationPaid == false
        && request.resource.data.billingCycle == "monthly"
        && request.resource.data.lastActivationSource == "launch_promo"
        && request.resource.data.lastSubscriptionGrantId == "launch50_" + uid
        && request.resource.data.launchPromoCampaignId == "launch50"
        && request.resource.data.subscriptionExpiresAt > request.time
        && existsAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId))
        && getAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId)).data.status == "granted"
        && getAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId)).data.userId == uid
        && getAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId)).data.campaignId == "launch50"
        && getAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId)).data.paymentRequired == false
        && getAfter(subscriptionGrantPath(request.resource.data.lastSubscriptionGrantId)).data.grantedBy == request.auth.uid
        && existsAfter(platformCounterPath("launch50"))
        && getAfter(platformCounterPath("launch50")).data.count <= 50
        && getAfter(platformCounterPath("launch50")).data.lastGrantedUserId == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "isActive","subscriptionStatus","initialActivationPaid","billingCycle",
          "subscriptionStartedAt","subscriptionExpiresAt","activatedAt",
          "lastActivationSource","lastSubscriptionGrantId","launchPromoCampaignId"
        ])
      )
    )
   ) || (
    signedIn()
    && resource.data.accessModel == "merchant_trial_v1"
    && resource.data.isActive == true
    && resource.data.subscriptionStatus == "trial"
    && resource.data.firstMerchantLinkedAt == null
    && request.resource.data.firstMerchantLinkedAt == request.time
    && request.resource.data.firstMerchantProjectId is string
    && request.resource.data.firstMerchantProjectId.size() > 0
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "firstMerchantLinkedAt","firstMerchantProjectId"
    ])
    && projectExists(request.resource.data.firstMerchantProjectId)
    && projectData(request.resource.data.firstMerchantProjectId).ownerId == uid
    && commissionAgreementExists(request.resource.data.firstMerchantProjectId)
    && get(commissionAgreementPath(request.resource.data.firstMerchantProjectId)).data.status != "accepted"
    && getAfter(commissionAgreementPath(request.resource.data.firstMerchantProjectId)).data.status == "accepted"
    && getAfter(commissionAgreementPath(request.resource.data.firstMerchantProjectId)).data.acceptedAt == request.time
    && getAfter(commissionAgreementPath(request.resource.data.firstMerchantProjectId)).data.acceptedBy == request.auth.uid
    && getAfter(commissionAgreementPath(request.resource.data.firstMerchantProjectId)).data.acceptedVersion > 0
    && operatorExists(request.resource.data.firstMerchantProjectId)
    && operatorData(request.resource.data.firstMerchantProjectId).authUid == request.auth.uid
   ) || (
    signedIn()
    && request.auth.uid == uid
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"])
    && request.resource.data.name is string
    && request.resource.data.name.size() > 0
    && request.resource.data.name.size() <= 100
   );
   allow delete: if isAdmin();
  }

  match /subscriptionBillingGuards/{uid} {
   function matchingPendingPayment(paymentId){
    let p=getAfter(subscriptionPaymentPath(paymentId)).data;
    return p.userId==uid && p.status=="pending_review";
   }
   function reviewedPayment(paymentId){
    let p=getAfter(subscriptionPaymentPath(paymentId)).data;
    return p.userId==uid && p.status in ["approved","rejected"]
      && p.reviewedBy==request.auth.uid;
   }
   allow get: if isAdmin() || (signedIn() && request.auth.uid==uid);
   allow list: if isAdmin();
   allow create: if request.resource.data.userId==uid
    && request.resource.data.revision==1
    && request.resource.data.lastReviewedPaymentId==""
    && request.resource.data.updatedAt==request.time
    && (
     (signedIn() && request.auth.uid==uid
      && request.resource.data.recoverySafe==false
      && request.resource.data.pendingPaymentId is string
      && request.resource.data.pendingPaymentId.size()>0
      && request.resource.data.keys().hasOnly([
       "userId","revision","lastReviewedPaymentId","updatedAt",
       "recoverySafe","pendingPaymentId"])
      && matchingPendingPayment(request.resource.data.pendingPaymentId))
     || (isAdmin() && request.resource.data.pendingPaymentId==""
      && request.resource.data.recoverySafe==true
      && request.resource.data.reconciledAt==request.time
      && request.resource.data.reconciledBy==request.auth.uid
      && request.resource.data.keys().hasOnly([
       "userId","revision","lastReviewedPaymentId","updatedAt",
       "recoverySafe","pendingPaymentId","reconciledAt","reconciledBy"]))
     || (isAdmin()
      && request.resource.data.pendingPaymentId is string
      && request.resource.data.pendingPaymentId.size()>0
      && request.resource.data.recoverySafe==false
      && request.resource.data.migratedAt==request.time
      && request.resource.data.migratedBy==request.auth.uid
      && get(subscriptionPaymentPath(request.resource.data.pendingPaymentId)).data.userId==uid
      && get(subscriptionPaymentPath(request.resource.data.pendingPaymentId)).data.status=="pending_review"
      && request.resource.data.keys().hasOnly([
       "userId","revision","lastReviewedPaymentId","updatedAt",
       "recoverySafe","pendingPaymentId","migratedAt","migratedBy"]))
    );
   allow update: if request.resource.data.userId==uid
    && resource.data.userId==uid
    && request.resource.data.revision==resource.data.revision+1
    && request.resource.data.updatedAt==request.time
    && (
     (signedIn() && request.auth.uid==uid
      && resource.data.pendingPaymentId==""
      && request.resource.data.pendingPaymentId is string
      && request.resource.data.pendingPaymentId.size()>0
      && request.resource.data.lastReviewedPaymentId==resource.data.lastReviewedPaymentId
      && request.resource.data.recoverySafe==resource.data.recoverySafe
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "pendingPaymentId","revision","updatedAt"])
      && matchingPendingPayment(request.resource.data.pendingPaymentId))
     || (isAdmin() && resource.data.pendingPaymentId is string
      && resource.data.pendingPaymentId.size()>0
      && request.resource.data.pendingPaymentId==""
      && request.resource.data.lastReviewedPaymentId==resource.data.pendingPaymentId
      && request.resource.data.recoverySafe==resource.data.recoverySafe
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "pendingPaymentId","lastReviewedPaymentId","revision","updatedAt"])
      && reviewedPayment(resource.data.pendingPaymentId))
     || (isAdmin() && resource.data.pendingPaymentId==""
      && request.resource.data.pendingPaymentId==""
      && resource.data.recoverySafe==false
      && request.resource.data.recoverySafe==true
      && request.resource.data.lastReviewedPaymentId==resource.data.lastReviewedPaymentId
      && request.resource.data.reconciledAt==request.time
      && request.resource.data.reconciledBy==request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "recoverySafe","reconciledAt","reconciledBy","revision","updatedAt"]))
    );
   allow delete: if false;
  }

  match /subscriptionPayments/{paymentId} {
   allow create: if signedIn()
    && request.resource.data.paymentId == paymentId
    && getAfter(billingGuardPath(request.auth.uid)).data.userId==request.auth.uid
    && getAfter(billingGuardPath(request.auth.uid)).data.pendingPaymentId==paymentId
    && getAfter(billingGuardPath(request.auth.uid)).data.updatedAt==request.time
    && request.resource.data.userId == request.auth.uid
    && request.resource.data.userEmail is string
    && request.resource.data.userEmail.size() <= 254
    && request.resource.data.paymentType in ["initial","renewal"]
    && request.resource.data.amount is number
    && (
      (
        request.resource.data.paymentType == "initial"
        && (
          (userExists(request.auth.uid)
            && ("accessModel" in userData(request.auth.uid))
            && userData(request.auth.uid).accessModel == "merchant_trial_v1"
            && request.resource.data.amount == 59)
          || (
            userExists(request.auth.uid)
            && (!("accessModel" in userData(request.auth.uid)) || userData(request.auth.uid).accessModel != "merchant_trial_v1")
            && request.resource.data.amount == 350
          )
        )
      )
      || (request.resource.data.paymentType == "renewal" && request.resource.data.amount == 59)
    )
    && request.resource.data.currency == "EGP"
    && request.resource.data.paymentMethod == "instapay"
    && request.resource.data.paymentReference is string
    && request.resource.data.paymentReference.size() >= 4
    && request.resource.data.paymentReference.size() <= 120
    && request.resource.data.paymentCode is string
    && request.resource.data.paymentCode.size() >= 8
    && request.resource.data.paymentCode.size() <= 40
    && request.resource.data.proofChannel == "whatsapp"
    && request.resource.data.status == "pending_review"
    && request.resource.data.submittedAt == request.time
    && request.resource.data.whatsappPreparedAt == request.time
    && request.resource.data.reviewedAt == null
    && request.resource.data.reviewedBy == ""
    && request.resource.data.rejectionReason == ""
    && request.resource.data.keys().hasOnly([
      "paymentId","paymentCode","userId","userEmail","paymentType","amount","currency",
      "paymentMethod","paymentReference","proofChannel","status","submittedAt",
      "whatsappPreparedAt","reviewedAt","reviewedBy","rejectionReason"
    ]);
   allow get, list: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
   allow update: if isAdmin()
    && getAfter(billingGuardPath(resource.data.userId)).data.pendingPaymentId==""
    && getAfter(billingGuardPath(resource.data.userId)).data.lastReviewedPaymentId==paymentId
    && getAfter(billingGuardPath(resource.data.userId)).data.updatedAt==request.time
    && resource.data.status == "pending_review"
    && request.resource.data.paymentId == resource.data.paymentId
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.userEmail == resource.data.userEmail
    && request.resource.data.paymentType == resource.data.paymentType
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.paymentMethod == resource.data.paymentMethod
    && request.resource.data.paymentReference == resource.data.paymentReference
    && request.resource.data.paymentCode == resource.data.paymentCode
    && request.resource.data.proofChannel == resource.data.proofChannel
    && request.resource.data.submittedAt == resource.data.submittedAt
    && request.resource.data.whatsappPreparedAt == resource.data.whatsappPreparedAt
    && request.resource.data.status in ["approved","rejected"]
    && request.resource.data.reviewedAt == request.time
    && request.resource.data.reviewedBy == request.auth.uid
    && (
      (
        request.resource.data.status == "approved"
        && request.resource.data.rejectionReason == ""
        && existsAfter(userPath(resource.data.userId))
        && getAfter(userPath(resource.data.userId)).data.isActive == true
        && getAfter(userPath(resource.data.userId)).data.subscriptionStatus == "active"
        && getAfter(userPath(resource.data.userId)).data.lastSubscriptionPaymentId == paymentId
        && getAfter(userPath(resource.data.userId)).data.lastPaymentType == resource.data.paymentType
        && getAfter(userPath(resource.data.userId)).data.lastPaymentAmount == resource.data.amount
      )
      || (
        request.resource.data.status == "rejected"
        && request.resource.data.rejectionReason is string
        && request.resource.data.rejectionReason.size() >= 3
        && request.resource.data.rejectionReason.size() <= 300
      )
    )
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status","reviewedAt","reviewedBy","rejectionReason"
    ]);
   allow delete: if false;
  }


  match /subscriptionGrants/{grantId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.userId == request.auth.uid);

   allow create: if isAdmin()
    && request.resource.data.grantId == grantId
    && request.resource.data.userId is string
    && request.resource.data.userId.size() > 0
    && grantId == "launch50_" + request.resource.data.userId
    && request.resource.data.campaignId == "launch50"
    && request.resource.data.status == "granted"
    && request.resource.data.paymentRequired == false
    && request.resource.data.value == 350
    && request.resource.data.currency == "EGP"
    && request.resource.data.subscriptionDays == 30
    && request.resource.data.grantedAt == request.time
    && request.resource.data.grantedBy == request.auth.uid
    && request.resource.data.keys().hasOnly([
      "grantId","userId","campaignId","status","paymentRequired","value",
      "currency","subscriptionDays","grantedAt","grantedBy"
    ])
    && existsAfter(userPath(request.resource.data.userId))
    && getAfter(userPath(request.resource.data.userId)).data.isActive == true
    && getAfter(userPath(request.resource.data.userId)).data.subscriptionStatus == "active"
    && getAfter(userPath(request.resource.data.userId)).data.lastActivationSource == "launch_promo"
    && getAfter(userPath(request.resource.data.userId)).data.lastSubscriptionGrantId == grantId
    && existsAfter(platformCounterPath("launch50"))
    && getAfter(platformCounterPath("launch50")).data.count <= 50
    && getAfter(platformCounterPath("launch50")).data.lastGrantedUserId == request.resource.data.userId;

   allow update, delete: if false;
  }

  match /platformCounters/{counterId} {
   allow get, list: if isAdmin();

   allow create: if isAdmin()
    && counterId == "launch50"
    && request.resource.data.campaignId == "launch50"
    && request.resource.data.count == 1
    && request.resource.data.limit == 50
    && request.resource.data.lastGrantedUserId is string
    && request.resource.data.lastGrantedUserId.size() > 0
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      "campaignId","count","limit","lastGrantedUserId","updatedAt"
    ])
    && existsAfter(subscriptionGrantPath("launch50_" + request.resource.data.lastGrantedUserId))
    && getAfter(subscriptionGrantPath("launch50_" + request.resource.data.lastGrantedUserId)).data.status == "granted";

   allow update: if isAdmin()
    && counterId == "launch50"
    && resource.data.campaignId == "launch50"
    && resource.data.limit == 50
    && resource.data.count < 50
    && request.resource.data.campaignId == resource.data.campaignId
    && request.resource.data.limit == resource.data.limit
    && request.resource.data.count == resource.data.count + 1
    && request.resource.data.count <= 50
    && request.resource.data.lastGrantedUserId is string
    && request.resource.data.lastGrantedUserId.size() > 0
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      "campaignId","count","limit","lastGrantedUserId","updatedAt"
    ])
    && existsAfter(subscriptionGrantPath("launch50_" + request.resource.data.lastGrantedUserId))
    && getAfter(subscriptionGrantPath("launch50_" + request.resource.data.lastGrantedUserId)).data.status == "granted";

   allow delete: if false;
  }


  // Only cutover assignment fields can move; the prior project identity
  // and operational merchant remain immutable. Cache two getAfter reads.
  function validAtomicMerchantProjectCutover(projectId){
    let before = resource.data;
    let next = request.resource.data;
    let witness = getAfter(merchantCutoverPath(projectId)).data;
    return before.platformManaged == true
     && before.assignmentStatus == "platform_managed"
     && before.assignedSubscriberId == ""
     && next.platformManaged == true
     && next.assignmentStatus == "assigned_to_new_subscriber"
     && next.assignedSubscriberId is string
     && next.assignedSubscriberId.size() > 0
     && next.assignedSubscriberId != before.originalSubscriberId
     && next.assignmentUpdatedAt == request.time
     && next.cutoverAuditId == projectId
     && next.cutoverAt == request.time
     && next.cutoverAdminUid == request.auth.uid
     && next.diff(before).affectedKeys().hasOnly([
       "assignmentStatus","assignedSubscriberId","assignmentUpdatedAt",
       "cutoverAuditId","cutoverAt","cutoverAdminUid"
     ])
     && witness.status == "completed"
     && witness.assignedSubscriberId == next.assignedSubscriberId
     && witness.completedAt == request.time;
  }

  function validRepeatMerchantProjectRecovery(projectId){
    let before=resource.data;
    let after=request.resource.data;
    let id=projectId+"_"+string(after.assignmentCycle);
    let audit=getAfter(merchantRecoveryCyclePath(id)).data;
    let grant=getAfter(merchantHistoricGrantPath(projectId+"_"+before.assignedSubscriberId)).data;
    return before.platformManaged==true
     && before.assignmentStatus=="assigned_to_new_subscriber"
     && before.assignedSubscriberId is string
     && before.assignedSubscriberId.size()>0
     && after.assignmentCycle is int
     && after.assignmentCycle==((
        "assignmentCycle" in before) ? before.assignmentCycle:1)+1
     && after.platformManaged==true
     && after.assignmentStatus=="platform_managed"
     && after.assignedSubscriberId==""
     && after.assignmentUpdatedAt==request.time
     && after.recoveryAuditId==id
     && after.recoveryAt==request.time
     && after.recoveryAdminUid==request.auth.uid
     && after.recoveryReason in ["overdue_renewal","unpaid_first_month","confirmed_violation"]
     && after.diff(before).affectedKeys().hasOnly([
      "assignmentCycle","platformManaged","assignmentStatus","assignedSubscriberId",
      "assignmentUpdatedAt","recoveryAuditId","recoveryAt",
      "recoveryAdminUid","recoveryReason"])
     && audit.status=="completed" && audit.cycleId==id
     && audit.previousSubscriberId==before.assignedSubscriberId
     && audit.recoveredAt==request.time && audit.adminUid==request.auth.uid
     && grant.subscriberUid==before.assignedSubscriberId
     && grant.status=="historic_only" && grant.grantedAt==request.time;
  }
  function validRepeatMerchantProjectAssignment(projectId){
    let before=resource.data;
    let after=request.resource.data;
    let id=projectId+"_"+string(before.assignmentCycle);
    let witness=getAfter(merchantAssignmentCyclePath(id)).data;
    return before.platformManaged==true
     && before.assignmentStatus=="platform_managed"
     && before.assignedSubscriberId==""
     && before.assignmentCycle is int && before.assignmentCycle>=2
     && before.recoveryAuditId==id
     && after.platformManaged==true
     && after.assignmentStatus=="assigned_to_new_subscriber"
     && after.assignedSubscriberId is string
     && after.assignedSubscriberId.size()>0
     && after.assignedSubscriberId!=before.originalSubscriberId
     && after.assignmentUpdatedAt==request.time
     && after.cutoverAuditId==id
     && after.cutoverAt==request.time
     && after.cutoverAdminUid==request.auth.uid
     && after.diff(before).affectedKeys().hasOnly([
      "assignmentStatus","assignedSubscriberId","assignmentUpdatedAt",
      "cutoverAuditId","cutoverAt","cutoverAdminUid"])
     && witness.status=="completed" && witness.cycleId==id
     && witness.assignedSubscriberId==after.assignedSubscriberId
     && witness.completedAt==request.time
     && witness.completedBy==request.auth.uid;
  }

  match /projects/{projectId} {
   allow get: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || currentAssignedSubscriber(projectId)
    || historicCycleStatementAccess(projectId)
    || (signedIn() && ("platformManaged" in resource.data)
      && resource.data.platformManaged == true
      && resource.data.assignmentStatus == "assigned_to_new_subscriber"
      && resource.data.assignedSubscriberId == request.auth.uid
      && isVerifiedAssignedAfterCutover(projectId))
    || isLinkedProjectOperator(projectId)
    || (
      resource.data.template in ["laundry","cleaning","carwash"]
      && resource.data.isActive == true
      && resource.data.status == "active"
      && projectAvailable(projectId)
    );
   allow list: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (signedIn() && resource.data.platformManaged == true
      && resource.data.assignmentStatus == "assigned_to_new_subscriber"
      && resource.data.assignedSubscriberId == request.auth.uid);
   allow create: if signedIn() && subscriptionActive(request.auth.uid) && validActiveProjectCreate(projectId);
   allow update: if (
    isAdmin()
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.template == resource.data.template
    && (!("merchantId" in resource.data) || request.resource.data.merchantId == resource.data.merchantId)
    && (!("originalSubscriberId" in resource.data) || request.resource.data.originalSubscriberId == resource.data.originalSubscriberId)
    && (
      !("platformManaged" in resource.data)
      || resource.data.platformManaged != true
      || request.resource.data.operatorId == resource.data.operatorId
    )
    && (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "platformManaged","assignmentStatus","assignedSubscriberId","assignmentCycle",
        "assignmentUpdatedAt","recoveryAuditId","recoveryAt",
        "recoveryAdminUid","recoveryReason","cutoverAuditId","cutoverAt","cutoverAdminUid"
      ])
      || (
        ("platformManaged" in resource.data) && resource.data.platformManaged == false
        && request.resource.data.platformManaged == true
        && request.resource.data.assignmentStatus == "platform_managed"
        && request.resource.data.assignedSubscriberId == ""
        && request.resource.data.assignmentUpdatedAt == request.time
        && request.resource.data.recoveryAuditId == projectId
        && request.resource.data.recoveryAt == request.time
        && request.resource.data.recoveryAdminUid == request.auth.uid
        && request.resource.data.recoveryReason in ["overdue_renewal","unpaid_first_month","confirmed_violation"]
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.projectId == resource.data.projectId
        && request.resource.data.template == resource.data.template
        && request.resource.data.operatorId == resource.data.operatorId
        && request.resource.data.isActive == resource.data.isActive
        && request.resource.data.status == resource.data.status
        && request.resource.data.merchantId == resource.data.merchantId
        && request.resource.data.originalSubscriberId == resource.data.originalSubscriberId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "platformManaged","assignmentStatus","assignedSubscriberId",
          "assignmentUpdatedAt","recoveryAuditId","recoveryAt",
          "recoveryAdminUid","recoveryReason"
        ])
        && existsAfter(merchantRecoveryPath(projectId))
        && getAfter(merchantRecoveryPath(projectId)).data.status == "completed"
        && getAfter(merchantRecoveryPath(projectId)).data.recoveredAt == request.time
        && getAfter(merchantRecoveryPath(projectId)).data.adminUid == request.auth.uid
        && getAfter(merchantRecoveryPath(projectId)).data.previousSubscriberId == resource.data.assignedSubscriberId
        && getAfter(merchantRecoveryPath(projectId)).data.merchantId == resource.data.merchantId
        && getAfter(merchantRecoveryPath(projectId)).data.reason == request.resource.data.recoveryReason
      )
    || validAtomicMerchantProjectCutover(projectId)
    || validRepeatMerchantProjectRecovery(projectId)
    || validRepeatMerchantProjectAssignment(projectId)
    )
   ) || (
    signedIn()
    && (!("platformManaged" in resource.data) || resource.data.platformManaged == false)
    && resource.data.ownerId == request.auth.uid
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.template == resource.data.template
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["businessName","whatsappNumber","instapayLink","logo","coverImage","primaryColor","priceConfig","operatorId","partnerSetupStatus"])
    && !(
      resource.data.template == "laundry"
      && ("operatingModel" in resource.data)
      && resource.data.operatingModel == "partner_operated"
      && request.resource.data.diff(resource.data).affectedKeys().hasAny(["priceConfig"])
    )
    && (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["operatorId","partnerSetupStatus"])
      || (
        ("operatingModel" in resource.data)
        && resource.data.operatingModel == "partner_operated"
        && request.resource.data.operatorId == projectId
        && request.resource.data.partnerSetupStatus in ["partner_linked","active"]
      )
    )
   )
   || (
    signedIn()
    && (!("platformManaged" in resource.data) || resource.data.platformManaged == false)
    && resource.data.ownerId == request.auth.uid
    && resource.data.template == "laundry"
    && (
      !("operatingModel" in resource.data)
      || resource.data.operatingModel == "owner_operated"
    )
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.template == resource.data.template
    && request.resource.data.operatingModel == "partner_operated"
    && request.resource.data.templateVersion == 3
    && request.resource.data.operatorId == ""
    && request.resource.data.partnerSetupStatus == "not_started"
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "operatingModel",
      "templateVersion",
      "operatorId",
      "partnerSetupStatus"
    ])
   )
   || (
    signedIn()
    && resource.data.template == "laundry"
    && resource.data.operatingModel == "partner_operated"
    && isProjectOperator(projectId)
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.template == resource.data.template
    && request.resource.data.operatingModel == resource.data.operatingModel
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["priceConfig"])
   );
   allow delete: if isAdmin() && !isVerifiedPlatformManagedMerchant(projectId);
  }

  match /orders/{orderId} {
   allow create: if validOrderEnvelope(request.resource.data.projectId)
    && validOrderByTemplate(
      request.resource.data.projectId,
      request.resource.data.templateType
    );

   allow read: if isAdmin()
    || (
      resource.data.templateType in ["supermarket","laundry","restaurant","bakery"]
      && isProjectOperator(resource.data.projectId)
    )
    || (
      !(resource.data.templateType in ["supermarket","laundry","restaurant","bakery"])
      && ownsProject(resource.data.projectId)
    );

   function validTrackedLaundryOperationalUpdate(){
    let before = resource.data;
    let after = request.resource.data;
    let tracking = getAfter(orderTrackingPath(before.trackingToken)).data;
    return before.templateType == "laundry"
      && before.trackingToken is string
      && before.trackingToken.size() >= 40
      && signedIn()
      && (isAdmin() || isProjectOperator(before.projectId))
      && after.projectId == before.projectId
      && after.providerId == before.providerId
      && after.trackingToken == before.trackingToken
      && after.statusUpdatedBy == request.auth.uid
      && (
        (
          before.status == "new"
          && (
            (after.status == "accepted" && after.laundryStage == "accepted")
            || after.status == "canceled"
          )
        )
        ||
        (
          before.status == "accepted"
          && before.laundryStage is string
          && after.laundryStage is string
          && validLaundryTransition(
            before.status,
            before.laundryStage,
            after.status,
            after.laundryStage
          )
        )
      )
      && after.status != "done"
      && (
        after.status == "canceled"
        || after.laundryStage != "out_for_delivery"
      )
      && (
        after.status == "canceled"
        || after.laundryStage != "pickup_assigned"
        || (
          after.assignedWorkerId is string
          && after.assignedWorkerId.size() > 0
          && workerExists(after.assignedWorkerId)
          && workerData(after.assignedWorkerId).projectId == before.projectId
          && workerData(after.assignedWorkerId).role == "pickup_agent"
        )
      )
      && after.diff(before).affectedKeys().hasOnly([
        "status",
        "laundryStage",
        "statusUpdatedAt",
        "statusUpdatedBy"
      ])
      && tracking.trackingToken == before.trackingToken
      && tracking.orderId is string
      && tracking.projectId == before.projectId
      && tracking.templateType == "laundry"
      && tracking.status == laundryTrackingStatus(after)
      && tracking.items == after.items
      && tracking.subtotal == after.price
      && tracking.deliveryFee == 0
      && tracking.total == after.price;
   }

   allow update: if resource.data.templateType == "laundry"
    && ("trackingToken" in resource.data)
    && request.resource.data.status != "done"
    && (
      request.resource.data.status == "canceled"
      || request.resource.data.laundryStage != "out_for_delivery"
    )
    && validTrackedLaundryOperationalUpdate();

   allow update: if resource.data.templateType == "laundry"
    && ("trackingToken" in resource.data)
    && resource.data.status == "accepted"
    && resource.data.laundryStage == "ready_delivery"
    && request.resource.data.status == "accepted"
    && request.resource.data.laundryStage == "out_for_delivery"
    && validTrackedLaundryDispatchUpdate(orderId);

   allow update: if resource.data.templateType == "laundry"
    && ("trackingToken" in resource.data)
    && resource.data.status == "accepted"
    && resource.data.laundryStage == "out_for_delivery"
    && request.resource.data.status == "done"
    && request.resource.data.laundryStage == "delivered"
    && validTrackedLaundryDeliveryUpdate(orderId);

   // Cheap state guards keep unrelated partner-order updates from evaluating
   // the expensive commission rules and exhausting Firestore's expression budget.
   allow update: if !(
      resource.data.templateType == "laundry"
      && ("trackingToken" in resource.data)
    )
    && resource.data.templateType in ["supermarket","restaurant","bakery","laundry"]
    && (
      (
        resource.data.templateType in ["supermarket","restaurant","bakery"]
        && resource.data.status == "ready"
        && request.resource.data.status == "assigned"
      )
      ||
      (
        resource.data.templateType == "laundry"
        && resource.data.status == "accepted"
        && resource.data.laundryStage == "ready_delivery"
        && request.resource.data.status == "accepted"
        && request.resource.data.laundryStage == "out_for_delivery"
      )
    )
    && validDispatchCommissionUpdate(orderId);

   allow update: if !(
      resource.data.templateType == "laundry"
      && ("trackingToken" in resource.data)
    )
    && resource.data.templateType in ["supermarket","restaurant","bakery","laundry"]
    && (
      (
        resource.data.templateType in ["supermarket","restaurant","bakery"]
        && resource.data.status == "out_for_delivery"
        && request.resource.data.status == "delivered"
      )
      ||
      (
        resource.data.templateType == "laundry"
        && resource.data.status == "accepted"
        && resource.data.laundryStage == "out_for_delivery"
        && request.resource.data.status == "done"
        && request.resource.data.laundryStage == "delivered"
      )
    )
    && validLockedCommissionDeliveryUpdate(orderId);

   allow update: if !(
      resource.data.templateType == "laundry"
      && ("trackingToken" in resource.data)
    )
    && (
    (
      !(resource.data.templateType in ["supermarket","laundry","restaurant","bakery"])
      && (isAdmin() || ownsProject(resource.data.projectId))
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.providerId == resource.data.providerId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","laundryStage"])
      && request.resource.data.status in ["new","accepted","done","canceled"]
      && (
        !("laundryStage" in request.resource.data)
        || (
          resource.data.templateType == "laundry"
          && request.resource.data.laundryStage in ["accepted","picked_up","processing","ready_delivery","delivered"]
        )
      )
    )
    ||
    (
      (
        canOperateProject(resource.data.projectId)
      )
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.providerId == resource.data.providerId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "assignedWorkerId",
        "assignedWorkerName",
        "assignedWorkerRole",
        "assignedWorkerWhatsapp",
        "assignedAt",
        "assignmentUpdatedAt"
      ])
      && request.resource.data.assignedWorkerId is string
      && request.resource.data.assignedWorkerName is string
      && request.resource.data.assignedWorkerRole is string
      && request.resource.data.assignedWorkerWhatsapp is string
      && (
        request.resource.data.assignedWorkerId == ""
        || (
          workerExists(request.resource.data.assignedWorkerId)
          && workerData(request.resource.data.assignedWorkerId).projectId == resource.data.projectId
          && workerData(request.resource.data.assignedWorkerId).isActive == true
          && workerData(request.resource.data.assignedWorkerId).role
            == request.resource.data.assignedWorkerRole
          && workerData(request.resource.data.assignedWorkerId).name
            == request.resource.data.assignedWorkerName
          && workerData(request.resource.data.assignedWorkerId).whatsapp
            == request.resource.data.assignedWorkerWhatsapp
        )
      )
    )
    ||
    (
      resource.data.templateType == "laundry"
      && (isAdmin() || isProjectOperator(resource.data.projectId))
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.providerId == resource.data.providerId
      && request.resource.data.statusUpdatedBy == request.auth.uid
      && (
        (
          resource.data.status == "new"
          && (
            (
              request.resource.data.status == "accepted"
              && request.resource.data.laundryStage == "accepted"
            )
            || request.resource.data.status == "canceled"
          )
        )
        ||
        (
          resource.data.status == "accepted"
          && resource.data.laundryStage is string
          && request.resource.data.laundryStage is string
          && validLaundryTransition(
            resource.data.status,
            resource.data.laundryStage,
            request.resource.data.status,
            request.resource.data.laundryStage
          )
        )
      )
      && (
        request.resource.data.status == "canceled"
        || (
          request.resource.data.laundryStage in ["accepted","pickup_assigned","picked_up","processing","ready_delivery","out_for_delivery","delivered"]
        )
      )
      && (
        request.resource.data.status == "canceled"
        || (
          request.resource.data.laundryStage == "pickup_assigned"
          && request.resource.data.assignedWorkerId is string
          && request.resource.data.assignedWorkerId.size() > 0
          && workerExists(request.resource.data.assignedWorkerId)
          && workerData(request.resource.data.assignedWorkerId).projectId == resource.data.projectId
          && workerData(request.resource.data.assignedWorkerId).role == "pickup_agent"
        )
        || (
          request.resource.data.laundryStage in ["out_for_delivery","delivered"]
          && request.resource.data.assignedWorkerId is string
          && request.resource.data.assignedWorkerId.size() > 0
          && workerExists(request.resource.data.assignedWorkerId)
          && workerData(request.resource.data.assignedWorkerId).projectId == resource.data.projectId
          && workerData(request.resource.data.assignedWorkerId).role == "delivery_agent"
        )
        || !(
          request.resource.data.laundryStage in ["pickup_assigned","out_for_delivery","delivered"]
        )
      )
      && (
        (
          request.resource.data.status != "done"
          && (
            request.resource.data.status == "canceled"
            || request.resource.data.laundryStage != "out_for_delivery"
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "laundryStage",
            "statusUpdatedAt",
            "statusUpdatedBy"
          ])
        )
        ||
        (
          request.resource.data.status == "done"
          && request.resource.data.laundryStage == "delivered"
          && commissionAgreementExists(resource.data.projectId)
          && commissionAgreementData(resource.data.projectId).status == "accepted"
          && commissionAgreementData(resource.data.projectId).currentAmount is number
          && request.resource.data.commissionEligible == true
          && request.resource.data.commissionLocked == true
          && request.resource.data.commissionAmount
            == commissionAgreementData(resource.data.projectId).currentAmount
          && request.resource.data.commissionAgreementVersion
            == commissionAgreementData(resource.data.projectId).acceptedVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "laundryStage",
            "statusUpdatedAt",
            "statusUpdatedBy",
            "deliveredAt",
            "commissionEligible",
            "commissionLocked",
            "commissionAmount",
            "commissionAgreementVersion"
          ])
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.orderId == orderId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.projectId
            == resource.data.projectId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.amount
            == request.resource.data.commissionAmount
        )
      )
    )
    ||
    (
      resource.data.templateType == "supermarket"
      && (isAdmin() || isProjectOperator(resource.data.projectId))
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.providerId == resource.data.providerId
      && request.resource.data.statusUpdatedBy == request.auth.uid
      && validSupermarketTransition(resource.data.status, request.resource.data.status)
      && (
        !(request.resource.data.status in ["assigned","out_for_delivery","delivered"])
        || (
          request.resource.data.assignedWorkerId is string
          && request.resource.data.assignedWorkerId.size() > 0
        )
      )
      && (
        (
          resource.data.status == "new"
          && request.resource.data.status == "accepted"
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.deliveryFee is number
          && request.resource.data.deliveryFee == supermarketData(resource.data.projectId).deliveryFee
          && request.resource.data.total is number
          && request.resource.data.total
            == request.resource.data.subtotal + request.resource.data.deliveryFee
          && request.resource.data.price == request.resource.data.total
          && request.resource.data.pricingLocked == true
          && request.resource.data.pricingLockedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "items",
            "subtotal",
            "deliveryFee",
            "total",
            "price",
            "pricingLocked",
            "pricingLockedAt",
            "pricingLockedBy",
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy"
          ])
        )
        ||
        (
          request.resource.data.status != "accepted"
          && request.resource.data.status != "assigned"
          && request.resource.data.status != "delivered"
          && (
            request.resource.data.status == "canceled"
            || resource.data.pricingLocked == true
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy"
          ])
        )
        ||
        (
          request.resource.data.status == "delivered"
          && resource.data.status == "out_for_delivery"
          && resource.data.pricingLocked == true
          && resource.data.assignedWorkerId is string
          && resource.data.assignedWorkerId.size() > 0
          && commissionAgreementExists(resource.data.projectId)
          && commissionAgreementData(resource.data.projectId).status == "accepted"
          && commissionAgreementData(resource.data.projectId).currentAmount is number
          && request.resource.data.commissionEligible == true
          && request.resource.data.commissionLocked == true
          && request.resource.data.commissionAmount
            == commissionAgreementData(resource.data.projectId).currentAmount
          && request.resource.data.commissionAgreementVersion
            == commissionAgreementData(resource.data.projectId).acceptedVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy",
            "deliveredAt",
            "commissionEligible",
            "commissionLocked",
            "commissionAmount",
            "commissionAgreementVersion"
          ])
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.orderId == orderId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.projectId
            == resource.data.projectId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.amount
            == request.resource.data.commissionAmount
        )
      )
    )
    ||
    (
      resource.data.templateType in ["restaurant","bakery"]
      && (isAdmin() || isProjectOperator(resource.data.projectId))
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.providerId == resource.data.providerId
      && request.resource.data.statusUpdatedBy == request.auth.uid
      && validSupermarketTransition(resource.data.status, request.resource.data.status)
      && (
        !(request.resource.data.status in ["assigned","out_for_delivery","delivered"])
        || (
          request.resource.data.assignedWorkerId is string
          && request.resource.data.assignedWorkerId.size() > 0
        )
      )
      && (
        (
          resource.data.status == "new"
          && request.resource.data.status == "accepted"
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 50
          && request.resource.data.subtotal is number
          && request.resource.data.subtotal >= 0
          && request.resource.data.deliveryFee is number
          && request.resource.data.deliveryFee == restaurantData(resource.data.projectId).deliveryFee
          && request.resource.data.total is number
          && request.resource.data.total
            == request.resource.data.subtotal + request.resource.data.deliveryFee
          && request.resource.data.price == request.resource.data.total
          && request.resource.data.pricingLocked == true
          && request.resource.data.pricingLockedBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "items",
            "subtotal",
            "deliveryFee",
            "total",
            "price",
            "pricingLocked",
            "pricingLockedAt",
            "pricingLockedBy",
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy"
          ])
        )
        ||
        (
          request.resource.data.status != "accepted"
          && request.resource.data.status != "assigned"
          && request.resource.data.status != "delivered"
          && (
            request.resource.data.status == "canceled"
            || resource.data.pricingLocked == true
          )
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy"
          ])
        )
        ||
        (
          request.resource.data.status == "delivered"
          && resource.data.status == "out_for_delivery"
          && resource.data.pricingLocked == true
          && resource.data.assignedWorkerId is string
          && resource.data.assignedWorkerId.size() > 0
          && commissionAgreementExists(resource.data.projectId)
          && commissionAgreementData(resource.data.projectId).status == "accepted"
          && commissionAgreementData(resource.data.projectId).currentAmount is number
          && request.resource.data.commissionEligible == true
          && request.resource.data.commissionLocked == true
          && request.resource.data.commissionAmount
            == commissionAgreementData(resource.data.projectId).currentAmount
          && request.resource.data.commissionAgreementVersion
            == commissionAgreementData(resource.data.projectId).acceptedVersion
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "status",
            "statusUpdatedAt",
            "statusUpdatedBy",
            "deliveredAt",
            "commissionEligible",
            "commissionLocked",
            "commissionAmount",
            "commissionAgreementVersion"
          ])
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.orderId == orderId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.projectId
            == resource.data.projectId
          && getAfter(commissionLedgerPath("project_order_" + orderId)).data.amount
            == request.resource.data.commissionAmount
        )
      )
    )
   );

   allow delete: if isAdmin()
    || (
      !(resource.data.templateType in ["supermarket","laundry","restaurant","bakery"])
      && ownsProject(resource.data.projectId)
    );
  }

  match /carwashSubscriptions/{subscriptionId} {
   allow get: if !exists(/databases/$(database)/documents/carwashSubscriptions/$(subscriptionId)) || isAdmin() || ownsProject(resource.data.projectId) || (resource.data.projectId is string && projectAvailable(resource.data.projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId) && request.resource.data.status == "active" && request.resource.data.totalWashes is number && request.resource.data.remainingWashes is number && request.resource.data.totalWashes > 0 && request.resource.data.remainingWashes == request.resource.data.totalWashes);
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","totalWashes","remainingWashes","startsAt","expiresAt","nextWashDate","preferredTime","intervalDays","cycleNumber","lastWashAt","updatedAt"]) && request.resource.data.remainingWashes is number && request.resource.data.remainingWashes >= 0 && request.resource.data.totalWashes is number && request.resource.data.totalWashes > 0 && request.resource.data.remainingWashes <= request.resource.data.totalWashes);
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
   match /washes/{washId} {
    allow get, list: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId)) || (carwashSubscriptionExists(subscriptionId) && projectAvailable(carwashSubscriptionData(subscriptionId).projectId));
    allow create: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId) && request.resource.data.projectId == carwashSubscriptionData(subscriptionId).projectId && request.resource.data.sequence is number && request.resource.data.sequence > 0);
    allow update, delete: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId));
   }
  }

  match /carwashCustomers/{subscriptionId} {
   allow get: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId));
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId);
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
  }

  match /carwashSubscriptionRequests/{subscriptionId} {
   allow get: if !exists(/databases/$(database)/documents/carwashSubscriptionRequests/$(subscriptionId)) || isAdmin() || ownsProject(resource.data.projectId) || (resource.data.projectId is string && projectAvailable(resource.data.projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId)) || (request.resource.data.projectId is string && request.resource.data.status == "pending" && request.resource.data.orderId is string && request.resource.data.requestType in ["new","renewal"] && request.resource.data.keys().hasOnly(["projectId","status","orderId","requestType","updatedAt","createdAt"]) && projectAvailable(request.resource.data.projectId));
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId) || (request.resource.data.projectId == resource.data.projectId && request.resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","orderId","requestType","updatedAt"]) && request.resource.data.orderId is string && request.resource.data.requestType in ["new","renewal"] && resource.data.status in ["canceled","renewable","active"] && projectAvailable(resource.data.projectId) && (resource.data.status != "active" || (carwashSubscriptionExists(subscriptionId) && (carwashSubscriptionData(subscriptionId).status != "active" || carwashSubscriptionData(subscriptionId).remainingWashes <= 0 || carwashSubscriptionData(subscriptionId).expiresAt <= request.time))));
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
  }

  match /laundries/{laundryId} {
   allow get: if isAdmin()
    || ownsProject(laundryId)
    || isLinkedProjectOperator(laundryId)
    || (
      laundryPartnerReady(laundryId)
      && resource.data.isAcceptingOrders == true
    );

   allow list: if isAdmin()
    || ownsProject(resource.data.projectId)
    || isLinkedProjectOperator(resource.data.projectId);

   allow create: if signedIn()
