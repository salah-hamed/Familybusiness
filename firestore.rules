      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authUid","status","updatedAt"])
      && (
        (resource.data.agreementStatus == "accepted" && request.resource.data.status == "active")
        || (resource.data.agreementStatus != "accepted" && request.resource.data.status == "pending_agreement")
      )
    )
    || (
      signedIn()
      && resource.data.authUid == request.auth.uid
      && request.resource.data.authUid == resource.data.authUid
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["agreementStatus","status","isActive","updatedAt"])
      && (
        (
          request.resource.data.agreementStatus == "accepted"
          && request.resource.data.status == "active"
          && request.resource.data.isActive == true
          && commissionAgreementExists(resource.data.projectId)
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.status == "accepted"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.pendingStatus == "none"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.currentAmount is number
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.acceptedVersion > 0
        )
        || (
          request.resource.data.agreementStatus == "rejected"
          && request.resource.data.status == "pending_agreement"
          && request.resource.data.isActive == false
          && commissionAgreementExists(resource.data.projectId)
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.status == "rejected"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.pendingStatus == "none"
        )
      )
    );

   allow delete: if isAdmin();
  }

  match /commissionAgreements/{agreementId} {
   allow get: if isAdmin()
    || ownsProject(agreementId)
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
    );

   allow list: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
    );

   allow create: if signedIn()
    && agreementId == request.resource.data.projectId
    && request.resource.data.agreementId == agreementId
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.operatorId == agreementId
    && request.resource.data.currency == "EGP"
    && request.resource.data.unit == "per_completed_order"
    && request.resource.data.currentAmount == null
    && request.resource.data.acceptedVersion == 0
    && request.resource.data.pendingAmount is number
    && request.resource.data.pendingAmount >= 0
    && request.resource.data.status == "pending"
    && request.resource.data.pendingStatus == "pending"
    && request.resource.data.proposedBy == request.auth.uid
    && request.resource.data.version == 1
    && projectExists(request.resource.data.projectId)
    && projectData(request.resource.data.projectId).ownerId == request.auth.uid
    && projectData(request.resource.data.projectId).operatingModel == "partner_operated"
    && request.resource.data.templateId == projectData(request.resource.data.projectId).template
    && operatorExists(request.resource.data.operatorId)
    && operatorData(request.resource.data.operatorId).ownerId == request.auth.uid;

   allow update: if isAdmin()
    || (
      signedIn()
      && resource.data.ownerId == request.auth.uid
      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && request.resource.data.currentAmount == resource.data.currentAmount
      && request.resource.data.acceptedVersion == resource.data.acceptedVersion
      && request.resource.data.pendingAmount is number
      && request.resource.data.pendingAmount >= 0
      && request.resource.data.pendingStatus == "pending"
      && (
        (resource.data.currentAmount != null && request.resource.data.status == "accepted")
        || (resource.data.currentAmount == null && request.resource.data.status == "pending")
      )
      && request.resource.data.proposedBy == request.auth.uid
      && request.resource.data.version == resource.data.version + 1
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingAmount","pendingStatus","status","proposedAt","proposedBy","rejectedAt","updatedAt","version"])
    )
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && resource.data.pendingStatus == "pending"
      && request.resource.data.pendingAmount == null
      && request.resource.data.pendingStatus == "none"
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentAmount","acceptedVersion","pendingAmount","status","pendingStatus","lastDecision","acceptedAt","acceptedBy","rejectedAt","updatedAt"])
      && (
        (
          request.resource.data.lastDecision == "accepted"
          && request.resource.data.status == "accepted"
          && request.resource.data.currentAmount == resource.data.pendingAmount
          && request.resource.data.acceptedVersion == resource.data.version
          && request.resource.data.acceptedBy == request.auth.uid
        )
        || (
          request.resource.data.lastDecision == "rejected"
          && request.resource.data.currentAmount == resource.data.currentAmount
          && request.resource.data.acceptedVersion == resource.data.acceptedVersion
          && (
            (resource.data.currentAmount == null && request.resource.data.status == "rejected")
            || (resource.data.currentAmount != null && request.resource.data.status == "accepted")
          )
        )
      )
    );

   allow delete: if false;
  }


  match /orderTracking/{trackingToken} {
   allow get: if resource.data.trackingToken == trackingToken
    && resource.data.templateType in ["supermarket","restaurant","bakery"]
    && trackingTemplateReady(resource.data.projectId, resource.data.templateType);

   allow list: if false;

   allow create: if request.resource.data.trackingToken == trackingToken
    && trackingToken.size() >= 40
    && request.resource.data.templateType in ["supermarket","restaurant","bakery"]
    && request.resource.data.projectId is string
    && request.resource.data.orderId is string
    && request.resource.data.status == "new"
    && request.resource.data.items is list
    && request.resource.data.subtotal is number
    && request.resource.data.deliveryFee is number
    && request.resource.data.total is number
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt"
    ])
    && trackingTemplateReady(
      request.resource.data.projectId,
      request.resource.data.templateType
    )
    && getAfter(orderPath(request.resource.data.orderId)).data.projectId
      == request.resource.data.projectId
    && getAfter(orderPath(request.resource.data.orderId)).data.templateType
      == request.resource.data.templateType
    && getAfter(orderPath(request.resource.data.orderId)).data.trackingToken
      == trackingToken
    && getAfter(orderPath(request.resource.data.orderId)).data.status
      == request.resource.data.status
    && getAfter(orderPath(request.resource.data.orderId)).data.items
      == request.resource.data.items
    && getAfter(orderPath(request.resource.data.orderId)).data.subtotal
      == request.resource.data.subtotal
    && getAfter(orderPath(request.resource.data.orderId)).data.deliveryFee
      == request.resource.data.deliveryFee
    && getAfter(orderPath(request.resource.data.orderId)).data.total
      == request.resource.data.total;

   allow update: if (
      isAdmin()
      || isProjectOperator(resource.data.projectId)
    )
    && request.resource.data.trackingToken == resource.data.trackingToken
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.templateType == resource.data.templateType
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.status
      == getAfter(orderPath(resource.data.orderId)).data.status
    && request.resource.data.items
      == getAfter(orderPath(resource.data.orderId)).data.items
    && request.resource.data.subtotal
      == getAfter(orderPath(resource.data.orderId)).data.subtotal
    && request.resource.data.deliveryFee
      == getAfter(orderPath(resource.data.orderId)).data.deliveryFee
    && request.resource.data.total
      == getAfter(orderPath(resource.data.orderId)).data.total
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "updatedAt",
      "deliveredAt"
    ])
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt",
      "deliveredAt"
    ]);

   allow delete: if false;
  }

  match /referrals/{referralId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.referrerUserId == request.auth.uid);
   allow create: if isAdmin();
   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","paidAt"]);
   allow delete: if false;
  }

  match /commissionLedger/{entryId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.userId == request.auth.uid)
    || (
      signedIn()
      && resource.data.sourceType == "project_order"
      && resource.data.projectId is string
      && isProjectOperator(resource.data.projectId)
    );

   allow create: if isAdmin()
    || validProjectOrderLedgerCreate(entryId);

   allow update: if (
    isAdmin()
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.sourceType == resource.data.sourceType
    && request.resource.data.sourceId == resource.data.sourceId
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "paidAt",
      "settlementId",
      "settlementStatus",
      "settlementCreatedAt"
    ])
   )
   ||
   (
    signedIn()
    && resource.data.sourceType == "project_order"
    && resource.data.userId == request.auth.uid
    && resource.data.status == "earned"
    && request.resource.data.status == "reversed"
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.sourceType == resource.data.sourceType
    && request.resource.data.sourceId == resource.data.sourceId
    && request.resource.data.agreementId == resource.data.agreementId
    && request.resource.data.agreementVersion == resource.data.agreementVersion
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.reversedAt == request.time
    && request.resource.data.reversalId == "project_order_" + resource.data.orderId
    && request.resource.data.reversalConfirmedBy == request.auth.uid
    && exists(commissionReversalPath(request.resource.data.reversalId))
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.status == "confirmed"
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.ownerId == request.auth.uid
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.projectId == resource.data.projectId
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.orderId == resource.data.orderId
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.amount == resource.data.amount
    && request.resource.data.reversalReason
      == getAfter(commissionReversalPath(request.resource.data.reversalId)).data.reasonCode
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "reversedAt",
      "reversalId",
      "reversalReason",
      "reversalConfirmedBy"
    ])
   );

   allow delete: if false;
  }

  match /commissionReversals/{reversalId} {
   allow get, list: if isAdmin()
    || (
      signedIn()
      && resource.data.projectId is string
      && (
        ownsProject(resource.data.projectId)
        || isProjectOperator(resource.data.projectId)
      )
    );

   allow create: if signedIn()
    && request.resource.data.reversalId == reversalId
    && request.resource.data.orderId is string
    && request.resource.data.projectId is string
    && reversalId == "project_order_" + request.resource.data.orderId
    && request.resource.data.ledgerEntryId == "project_order_" + request.resource.data.orderId
    && isProjectOperator(request.resource.data.projectId)
    && projectExists(request.resource.data.projectId)
    && orderExists(request.resource.data.orderId)
    && exists(commissionLedgerPath(request.resource.data.ledgerEntryId))
    && request.resource.data.ownerId == projectData(request.resource.data.projectId).ownerId
    && request.resource.data.operatorId == projectData(request.resource.data.projectId).operatorId
    && request.resource.data.requestedBy == request.auth.uid
    && request.resource.data.currency == "EGP"
    && request.resource.data.amount is number
    && request.resource.data.amount > 0
    && request.resource.data.status == "pending_owner_confirmation"
    && request.resource.data.reasonCode in [
      "customer_canceled_after_dispatch",
      "delivery_failed",
      "duplicate_order",
      "operator_error",
      "other"
    ]
    && request.resource.data.createdAt == request.time
    && request.resource.data.requestedAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.confirmedAt == null
    && request.resource.data.confirmedBy == null
    && request.resource.data.rejectedAt == null
    && request.resource.data.rejectedBy == null
    && orderData(request.resource.data.orderId).projectId == request.resource.data.projectId
    && orderData(request.resource.data.orderId).status == "canceled"
    && orderData(request.resource.data.orderId).commissionLocked == true
    && orderData(request.resource.data.orderId).commissionAmount == request.resource.data.amount
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.projectId
      == request.resource.data.projectId
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.orderId
      == request.resource.data.orderId
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.amount
      == request.resource.data.amount
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.status == "earned";

   allow update: if signedIn()
    && resource.data.projectId is string
    && ownsProject(resource.data.projectId)
    && resource.data.ownerId == request.auth.uid
    && resource.data.status == "pending_owner_confirmation"
    && request.resource.data.reversalId == resource.data.reversalId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.ledgerEntryId == resource.data.ledgerEntryId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.reasonCode == resource.data.reasonCode
    && request.resource.data.note == resource.data.note
    && request.resource.data.requestedAt == resource.data.requestedAt
    && request.resource.data.requestedBy == resource.data.requestedBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "confirmedAt",
      "confirmedBy",
      "rejectedAt",
      "rejectedBy",
      "updatedAt"
    ])
    && (
      (
        request.resource.data.status == "confirmed"
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.rejectedAt == null
        && request.resource.data.rejectedBy == null
      )
      ||
      (
        request.resource.data.status == "rejected"
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
      )
    );

   allow delete: if false;
  }

  match /commissionSettlements/{settlementId} {
   allow get, list: if isAdmin()
    || (
      signedIn()
      && resource.data.projectId is string
      && (
        ownsProject(resource.data.projectId)
        || isProjectOperator(resource.data.projectId)
      )
    );

   allow create: if signedIn()
    && request.resource.data.settlementId == settlementId
    && request.resource.data.projectId is string
    && isProjectOperator(request.resource.data.projectId)
    && projectExists(request.resource.data.projectId)
    && request.resource.data.ownerId == projectData(request.resource.data.projectId).ownerId
    && request.resource.data.operatorId == projectData(request.resource.data.projectId).operatorId
    && request.resource.data.declaredBy == request.auth.uid
    && request.resource.data.amount is number
    && request.resource.data.amount > 0
    && request.resource.data.currency == "EGP"
    && request.resource.data.status == "pending_owner_confirmation"
    && request.resource.data.createdAt == request.time
    && request.resource.data.declaredAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.confirmedAt == null
    && request.resource.data.confirmedBy == null
    && request.resource.data.rejectedAt == null
    && request.resource.data.rejectedBy == null;

   allow update: if signedIn()
    && resource.data.projectId is string
    && ownsProject(resource.data.projectId)
    && resource.data.ownerId == request.auth.uid
    && resource.data.status == "pending_owner_confirmation"
    && request.resource.data.settlementId == resource.data.settlementId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.templateId == resource.data.templateId
    && request.resource.data.businessName == resource.data.businessName
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.paymentMethod == resource.data.paymentMethod
    && request.resource.data.paymentReference == resource.data.paymentReference
    && request.resource.data.note == resource.data.note
    && request.resource.data.declaredAt == resource.data.declaredAt
    && request.resource.data.declaredBy == resource.data.declaredBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "confirmedAt",
      "confirmedBy",
      "rejectedAt",
      "rejectedBy",
      "updatedAt"
    ])
    && (
      (
        request.resource.data.status == "confirmed"
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.rejectedAt == null
        && request.resource.data.rejectedBy == null
      )
      ||
      (
        request.resource.data.status == "rejected"
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
      )
    );

   allow delete: if false;
  }

  match /commissionPaymentStates/{projectId} {
   allow get, list: if isAdmin()
    || ownsProject(projectId)
    || isProjectOperator(projectId);

   allow create: if signedIn()
    && (ownsProject(projectId) || isProjectOperator(projectId))
    && request.resource.data.projectId == projectId
    && request.resource.data.ownerId == projectData(projectId).ownerId
    && request.resource.data.operatorId == projectData(projectId).operatorId
    && request.resource.data.pendingSettlementId is string
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      "projectId",
      "ownerId",
      "operatorId",
      "pendingSettlementId",
      "updatedAt"
    ]);

   allow update: if signedIn()
    && (ownsProject(projectId) || isProjectOperator(projectId))
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.pendingSettlementId is string
    && request.resource.data.updatedAt == request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "pendingSettlementId",
      "updatedAt"
    ]);

   allow delete: if false;
  }

  match /{document=**} { allow read, write: if false; }
 }
}
