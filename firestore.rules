rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function userPath(uid){ return /databases/$(database)/documents/users/$(uid); }
  function projectPath(projectId){ return /databases/$(database)/documents/projects/$(projectId); }
  function operatorPath(operatorId){ return /databases/$(database)/documents/operators/$(operatorId); }
  function commissionAgreementPath(agreementId){ return /databases/$(database)/documents/commissionAgreements/$(agreementId); }
  function workerPath(workerId){ return /databases/$(database)/documents/workers/$(workerId); }
  function orderPath(orderId){ return /databases/$(database)/documents/orders/$(orderId); }
  function orderTrackingPath(trackingToken){ return /databases/$(database)/documents/orderTracking/$(trackingToken); }
  function supermarketPath(projectId){ return /databases/$(database)/documents/supermarkets/$(projectId); }
  function restaurantPath(projectId){ return /databases/$(database)/documents/restaurants/$(projectId); }
  function laundryPath(projectId){ return /databases/$(database)/documents/laundries/$(projectId); }
  function commissionLedgerPath(entryId){ return /databases/$(database)/documents/commissionLedger/$(entryId); }
  function commissionReversalPath(reversalId){ return /databases/$(database)/documents/commissionReversals/$(reversalId); }
  function subscriptionPaymentPath(paymentId){ return /databases/$(database)/documents/subscriptionPayments/$(paymentId); }
  function billingGuardPath(uid){ return /databases/$(database)/documents/subscriptionBillingGuards/$(uid); }
  function commissionSettlementPath(settlementId){ return /databases/$(database)/documents/commissionSettlements/$(settlementId); }
  function merchantViolationPath(projectId){ return /databases/$(database)/documents/merchantViolations/$(projectId); }
  function merchantRecoveryPath(projectId){ return /databases/$(database)/documents/merchantRecoveries/$(projectId); }
  function merchantTransferCasePath(projectId){ return /databases/$(database)/documents/merchantTransferCases/$(projectId); }
  function merchantTransferFinanceReviewPath(projectId){ return /databases/$(database)/documents/merchantTransferFinanceReviews/$(projectId); }
  function merchantCutoverPath(projectId){ return /databases/$(database)/documents/merchantAssignmentCutovers/$(projectId); }
  function subscriptionGrantPath(grantId){ return /databases/$(database)/documents/subscriptionGrants/$(grantId); }
  function platformCounterPath(counterId){ return /databases/$(database)/documents/platformCounters/$(counterId); }
  function trialRegistrationEnabled(){
   let config=/databases/$(database)/documents/platformSettings/trialRegistration;
   return exists(config) && get(config).data.enabled==true;
  }
  function userExists(uid){ return exists(userPath(uid)); }
  function userData(uid){ return get(userPath(uid)).data; }
  function isAdmin(){ return signedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == "admin"; }
  function subscriptionActive(uid){
   let user = userData(uid);
   return userExists(uid)
    && user.isActive == true
    && (
      (
        user.subscriptionStatus == "active"
        && (!("subscriptionExpiresAt" in user) || user.subscriptionExpiresAt > request.time)
        && (
          !("accessModel" in user) || user.accessModel != "merchant_trial_v1"
          || (
            ("subscriptionExpiresAt" in user)
            && (
              user.initialActivationPaid == true
              || ("lastSubscriptionPaymentId" in user && user.lastSubscriptionPaymentId is string)
              || ("lastActivationSource" in user && user.lastActivationSource == "launch_promo")
            )
          )
        )
      )
      || (
        ("accessModel" in user)
        && user.accessModel == "merchant_trial_v1"
        && user.subscriptionStatus == "trial"
        && user.initialActivationPaid == false
        && !("lastSubscriptionPaymentId" in user)
        && user.createdAt is timestamp
        && user.createdAt <= request.time
        && (
          (
            user.firstMerchantLinkedAt == null
            && request.time < user.createdAt + duration.value(7, 'd')
          )
          || (
            user.firstMerchantLinkedAt is timestamp
            && user.firstMerchantLinkedAt >= user.createdAt
            && user.firstMerchantLinkedAt <= request.time
            && request.time < user.firstMerchantLinkedAt + duration.value(3, 'd')
          )
        )
      )
    );
  }
  function projectExists(projectId){ return exists(projectPath(projectId)); }
  function projectData(projectId){ return get(projectPath(projectId)).data; }
  function isVerifiedPlatformManagedMerchant(projectId){
   let p = projectData(projectId);
   return projectExists(projectId)
    && ("platformManaged" in p) && p.platformManaged == true
    && p.template in ["supermarket","restaurant","bakery","laundry"]
    && p.operatingModel == "partner_operated"
    && p.assignmentStatus == "platform_managed"
    && p.assignedSubscriberId == ""
    && p.recoveryAuditId == projectId
    && p.recoveryAt is timestamp
    && p.recoveryAdminUid is string
    && exists(merchantRecoveryPath(projectId))
    && get(merchantRecoveryPath(projectId)).data.status == "completed"
    && get(merchantRecoveryPath(projectId)).data.recoveredAt == p.recoveryAt
    && get(merchantRecoveryPath(projectId)).data.adminUid == p.recoveryAdminUid
    && get(merchantRecoveryPath(projectId)).data.previousSubscriberId == p.originalSubscriberId
    && get(merchantRecoveryPath(projectId)).data.merchantId == p.merchantId;
  }
  // Signed immutable witness was created in an atomic transaction with
  // accepted dual consents and admin-only finance review. The transfer case
  // cannot change after cutover_completed; verifying it on every rider
  // dispatch would repeat the same history and exhaust the Rules budget.
  function cutoverDocumentsMatch(projectId,p){
   let a = get(merchantCutoverPath(projectId)).data;
   return a.status == "completed"
    && a.projectDocId == projectId
    && a.merchantId == p.merchantId
    && a.originalSubscriberId == p.originalSubscriberId
    && a.assignedSubscriberId == p.assignedSubscriberId
    && a.completedAt == p.cutoverAt
    && a.completedBy == p.cutoverAdminUid;
  }
  function isVerifiedAssignedAfterCutover(projectId){
   let p = projectData(projectId);
   return projectExists(projectId)
    && ("platformManaged" in p) && p.platformManaged == true
    && ("assignmentStatus" in p) && p.assignmentStatus == "assigned_to_new_subscriber"
    && p.assignedSubscriberId is string
    && p.assignedSubscriberId.size() > 0
    && p.assignedSubscriberId != p.originalSubscriberId
    && p.cutoverAuditId == projectId
    && p.cutoverAt is timestamp
    && p.cutoverAdminUid is string
    && p.recoveryAuditId == projectId
    && cutoverDocumentsMatch(projectId,p);
  }
  // C4B12: v2+ epoch witnesses are isolated from immutable C4B11 records.

  function currentAssignedSubscriber(projectId){
   return signedIn() && isVerifiedAssignedAfterCutover(projectId)
    && projectData(projectId).assignedSubscriberId == request.auth.uid
    && subscriptionActive(request.auth.uid);
  }
  function historicProjectOwner(projectId){
   return signedIn() && projectExists(projectId)
    && projectData(projectId).ownerId == request.auth.uid;
  }
  function ownsProject(projectId){
   return currentAssignedSubscriber(projectId)
    || (historicProjectOwner(projectId)
      && (!("platformManaged" in projectData(projectId))
       || projectData(projectId).platformManaged == false));
  }
  function commissionBeneficiary(projectId){
   let p=projectData(projectId);
   // Choose the one live state FIRST. Verifying a non-applicable audit
   // can exhaust Firestore's rule-evaluation budget in rider dispatch.
   return !("platformManaged" in p) || p.platformManaged==false
    ? ((("assignedSubscriberId" in p) && p.assignedSubscriberId!=p.ownerId)
       ? "" : p.ownerId)
    : (p.assignmentStatus=="platform_managed"
       ? (isVerifiedPlatformManagedMerchant(projectId)
          ? "__fb_platform_commissions__" : "")
       : (p.assignmentStatus=="assigned_to_new_subscriber"
         ? (isVerifiedAssignedAfterCutover(projectId) ? p.assignedSubscriberId : "")
         : ""));
  }
  function projectAvailable(projectId){
   let project = projectData(projectId);
   return projectExists(projectId)
    && project.isActive == true
    && project.status == "active"
    && ((("platformManaged" in project) && project.platformManaged == true
        && (isVerifiedPlatformManagedMerchant(projectId)
        || isVerifiedAssignedAfterCutover(projectId)))
        || ((!('platformManaged' in project) || project.platformManaged == false)
            && subscriptionActive(project.ownerId)));
  }
  function operatorExists(operatorId){ return exists(operatorPath(operatorId)); }
  function operatorData(operatorId){ return get(operatorPath(operatorId)).data; }
  function isOperator(operatorId){ return signedIn() && operatorExists(operatorId) && operatorData(operatorId).authUid == request.auth.uid; }
  function workerExists(workerId){ return exists(workerPath(workerId)); }
  function workerData(workerId){ return get(workerPath(workerId)).data; }
  function orderExists(orderId){ return exists(orderPath(orderId)); }
  function orderData(orderId){ return get(orderPath(orderId)).data; }
  function commissionAgreementExists(agreementId){ return exists(commissionAgreementPath(agreementId)); }
  function commissionAgreementData(agreementId){ return get(commissionAgreementPath(agreementId)).data; }
  function projectOrderLedgerAfterMatches(orderId, projectId, amount, version){
   let ledger = getAfter(commissionLedgerPath("project_order_" + orderId)).data;
   return ledger.orderId == orderId
    && ledger.projectId == projectId
    && ledger.amount == amount
    && ledger.agreementVersion == version;
  }
  function projectOrderLedgerExistsMatches(orderId, projectId, amount, version){
   return exists(commissionLedgerPath("project_order_" + orderId))
    && get(commissionLedgerPath("project_order_" + orderId)).data.orderId == orderId
    && get(commissionLedgerPath("project_order_" + orderId)).data.projectId == projectId
    && get(commissionLedgerPath("project_order_" + orderId)).data.amount == amount
    && get(commissionLedgerPath("project_order_" + orderId)).data.agreementVersion == version;
  }
  function validCommissionTriggerState(order){
   return (
      order.templateType in ["supermarket","restaurant","bakery"]
      && (
        (order.status == "assigned" && order.assignedWorkerRole == "rider")
        || order.status == "delivered"
      )
    )
    || (
      order.templateType == "laundry"
      && (
        (
          order.status == "accepted"
          && order.laundryStage == "out_for_delivery"
          && order.assignedWorkerRole == "delivery_agent"
        )
        || (
          order.status == "done"
          && order.laundryStage == "delivered"
        )
      )
    );
  }
  function commissionCycleMatches(order,ledger){
    let p=projectData(ledger.projectId);
    return (("assignmentCycle" in p) && p.assignmentCycle is int
        && p.assignmentCycle>=2)
      ? ("assignmentCycle" in ledger
        && ledger.assignmentCycle==p.assignmentCycle
        && ("commissionAssignmentCycle" in order)
        && order.commissionAssignmentCycle==p.assignmentCycle)
      : !("assignmentCycle" in ledger)
        && !("commissionAssignmentCycle" in order);
  }
  function validProjectOrderLedgerCreate(entryId){
   let ledger = request.resource.data;
   let order = getAfter(orderPath(ledger.orderId)).data;
   return signedIn()
    && !(order.templateType == "laundry" && ("trackingToken" in order))
    && ledger.sourceType == "project_order"
     && ledger.userId is string && ledger.userId.size()>0
    && ledger.projectId is string
    && ledger.orderId is string
    && entryId == "project_order_" + ledger.orderId
    && ledger.sourceId == ledger.orderId
    && ledger.agreementId == ledger.projectId
    && ledger.currency == "EGP"
    && ledger.status == "earned"
    && ledger.paidAt == null
    && projectExists(ledger.projectId)
    && commissionAgreementExists(ledger.projectId)
    && isProjectOperator(ledger.projectId)
    && projectData(ledger.projectId).template in ["supermarket","laundry","restaurant","bakery"]
    && commissionAgreementData(ledger.projectId).status == "accepted"
    && commissionAgreementData(ledger.projectId).currentAmount is number
    && ledger.userId == commissionBeneficiary(ledger.projectId)
    && ledger.amount == commissionAgreementData(ledger.projectId).currentAmount
    && ledger.agreementVersion == commissionAgreementData(ledger.projectId).acceptedVersion
    && order.projectId == ledger.projectId
    && validCommissionTriggerState(order)
    && order.commissionLocked == true
    && order.commissionAmount == ledger.amount
    && order.commissionAgreementVersion == ledger.agreementVersion
    && commissionCycleMatches(order,ledger);
  }
  function validTrackedLaundryProjectOrderLedgerCreate(entryId){
   let ledger = request.resource.data;
   let order = getAfter(orderPath(ledger.orderId)).data;
   return signedIn()
    && ledger.sourceType == "project_order"
     && ledger.userId is string && ledger.userId.size()>0
    && ledger.projectId is xзMy¶‰ћЛkєwµзY›Ь›WЫX[YЩY‚€	‰€\ЬЪYЫ™YЭXњШЬљX™\’YOH€‚€	‰€›Ь\]Ь’YOH›Ъ™XЭY€	‰€њ™XЫЭ™\ћP]Y]YOH›Ъ™XЭY€	‰€њ™XЫЭ™\ћP]\И[Y\Э[\€	‰€›Y\Ъ[ќY›X]Ъ\К	Ч›WЦМNXKY—^ММџI	КB€	‰€]Y]њЭ]\ИOHЫЫ\]Y‚€	‰€]Y]њ™XЫЭ™\ћRYOH›Ъ™XЭY€	‰€]Y]њ›Ъ™XЭШТYOH›Ъ™XЭY€	‰€]Y]›Y\Ъ[ќYOH›Y\Ъ[ќY€	‰€]Y]›ЬљYЪ[[ЭXњШЬљX™\’YOH›ЬљYЪ[[ЭXњШЬљX™\’Y€	‰€]Y]њ™]љ[Э\ФЭXњШЬљX™\’YOH›ЬљYЪ[[ЭXњШЬљX™\’Y€	‰€]Y]YZ[•ZYOHњ™XЫЭ™\ћPYZ[•ZY€	‰€]Y]њ™XЫЭ™\™Y]OHњ™XЫЭ™\ћP]€	‰€Ь]]ZY\ИЭљ[™В€	‰€Ь]]ZYњЪ^™J
