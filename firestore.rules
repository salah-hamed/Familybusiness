      || request.resource.data.catalogCategories is list
    )
    && (
      !request.resource.data.diff(resource.data).affectedKeys().hasAny(["catalogProductCount"])
      || (
        request.resource.data.catalogProductCount is number
        && request.resource.data.catalogProductCount >= 0
      )
