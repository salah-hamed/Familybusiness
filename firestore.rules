rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn(){ return request.auth != null; }
  function userPath(uid){ return /databases/$(database)/documents/users/$(uid); }
  function projectPath(projectId){ return /databases/$(database)/documents/projects/$(projectId); }
  function carwashSubscriptionPath(subscriptionId){ return /databases/$(database)/documents/carwashSubscriptions/$(subscriptionId); }
  function userExists(uid){ return exists(userPath(uid)); }
  function userData(uid){ return get(userPath(uid)).data; }
  function isAdmin(){ return signedIn() && userExists(request.auth.uid) && userData(request.auth.uid).role == "admin"; }
  function subscriptionActive(uid){ return userExists(uid) && userData(uid).isActive == true && userData(uid).subscriptionStatus == "active"; }
  function projectExists(projectId){ return exists(projectPath(projectId)); }
  function projectData(projectId){ return get(projectPath(projectId)).data; }
  function ownsProject(projectId){ return signedIn() && projectExists(projectId) && projectData(projectId).ownerId == request.auth.uid; }
  function projectAvailable(projectId){ return projectExists(projectId) && projectData(projectId).isActive == true && projectData(projectId).status == "active" && subscriptionActive(projectData(projectId).ownerId); }
  function carwashSubscriptionExists(subscriptionId){ return exists(carwashSubscriptionPath(subscriptionId)); }
  function carwashSubscriptionData(subscriptionId){ return get(carwashSubscriptionPath(subscriptionId)).data; }

  function validOrderTemplate(projectId){
   return request.resource.data.templateType is string
    && projectData(projectId).template == request.resource.data.templateType;
  }

  function validCleaningOrder(projectId){
   let config = projectData(projectId).priceConfig;
   return request.resource.data.templateType == "cleaning"
    && request.resource.data.rooms is number
    && request.resource.data.rooms >= 0
    && request.resource.data.bathrooms is number
    && request.resource.data.bathrooms >= 0
    && request.resource.data.kitchen in ["yes","no"]
    && request.resource.data.stairs in ["yes","no"]
    && request.resource.data.price is number
    && (
      (
       request.resource.data.kitchen == "no"
       && request.resource.data.stairs == "no"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
      )
      ||
      (
       request.resource.data.kitchen == "yes"
       && request.resource.data.stairs == "no"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.kitchen
      )
      ||
      (
       request.resource.data.kitchen == "no"
       && request.resource.data.stairs == "yes"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.stairs
      )
      ||
      (
       request.resource.data.kitchen == "yes"
       && request.resource.data.stairs == "yes"
       && request.resource.data.price
        == config.base
         + request.resource.data.rooms * config.room
         + request.resource.data.bathrooms * config.bathroom
         + config.kitchen
         + config.stairs
      )
    );
  }

  function validCarwashOrder(projectId){
   let config = projectData(projectId).priceConfig;
   return request.resource.data.templateType == "carwash"
    && request.resource.data.serviceType == "external_car_wash"
    && request.resource.data.planType == "monthly_new"
    && request.resource.data.subscriptionKey is string
    && request.resource.data.renewal is bool
    && request.resource.data.packageWashes is number
    && request.resource.data.price is number
    && ("monthly" in config)
    && ("monthlyWashes" in config)
    && config.monthly >= 0
    && config.monthlyWashes > 0
    && request.resource.data.price == config.monthly
    && request.resource.data.packageWashes == config.monthlyWashes;
  }

  function validLaundryItem(item, expectedKey, washPrice, ironPrice, washOnly){
   return item.key == expectedKey
    && item.quantity is number
    && item.quantity >= 0
    && item.quantity <= 100
    && item.unitPrice is number
    && item.subtotal is number
    && (
      (washOnly == true && item["service"] == "wash" && item.unitPrice == washPrice)
      ||
      (washOnly == false && (
       (item["service"] == "wash" && item.unitPrice == washPrice)
       || (item["service"] == "iron" && item.unitPrice == ironPrice)
       || (item["service"] == "wash_iron" && item.unitPrice == washPrice + ironPrice)
      ))
    )
    && item.subtotal == item.quantity * item.unitPrice;
  }

  function validLaundryOrder(projectId){
   let config = projectData(projectId).priceConfig;
   return request.resource.data.templateType == "laundry"
    && request.resource.data.serviceType == "laundry_per_piece"
    && request.resource.data.items is list
    && request.resource.data.items.size() == 7
    && request.resource.data.totalPieces is number
    && request.resource.data.totalPieces > 0
    && request.resource.data.price is number
    && validLaundryItem(request.resource.data.items[0],"shirt",config.shirtWash,config.shirtIron,false)
    && validLaundryItem(request.resource.data.items[1],"trousers",config.trousersWash,config.trousersIron,false)
    && validLaundryItem(request.resource.data.items[2],"tshirt",config.tshirtWash,config.tshirtIron,false)
    && validLaundryItem(request.resource.data.items[3],"dress",config.dressWash,config.dressIron,false)
    && validLaundryItem(request.resource.data.items[4],"galabeya",config.galabeyaWash,config.galabeyaIron,false)
    && validLaundryItem(request.resource.data.items[5],"suit",config.suitWash,config.suitIron,false)
    && validLaundryItem(request.resource.data.items[6],"shoes",config.shoesWash,0,true)
    && request.resource.data.totalPieces
      == request.resource.data.items[0].quantity
       + request.resource.data.items[1].quantity
       + request.resource.data.items[2].quantity
       + request.resource.data.items[3].quantity
       + request.resource.data.items[4].quantity
       + request.resource.data.items[5].quantity
       + request.resource.data.items[6].quantity
    && request.resource.data.price
      == request.resource.data.items[0].subtotal
       + request.resource.data.items[1].subtotal
       + request.resource.data.items[2].subtotal
       + request.resource.data.items[3].subtotal
       + request.resource.data.items[4].subtotal
       + request.resource.data.items[5].subtotal
       + request.resource.data.items[6].subtotal;
  }

  match /users/{uid} {
   allow create: if signedIn() && request.auth.uid == uid && request.resource.data.uid == uid && request.resource.data.isActive == false && request.resource.data.subscriptionStatus == "pending" && !("role" in request.resource.data);
   allow get: if isAdmin() || (signedIn() && request.auth.uid == uid);
   allow list: if isAdmin();
   allow update: if isAdmin() || (signedIn() && request.auth.uid == uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name"]));
   allow delete: if isAdmin();
  }

  match /projects/{projectId} {
   allow get: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid) || (resource.data.isActive == true && resource.data.status == "active" && subscriptionActive(resource.data.ownerId));
   allow list: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
   allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid && request.resource.data.projectId is string && projectId == request.auth.uid + "_" + request.resource.data.projectId && subscriptionActive(request.auth.uid);
   allow update: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.projectId == resource.data.projectId && request.resource.data.template == resource.data.template && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["businessName","whatsappNumber","instapayLink","logo","coverImage","primaryColor","priceConfig"]));
   allow delete: if isAdmin() || (signedIn() && resource.data.ownerId == request.auth.uid);
  }

  match /orders/{orderId} {
   allow create: if request.resource.data.projectId is string
    && request.resource.data.providerId == request.resource.data.projectId
    && request.resource.data.status == "new"
    && projectAvailable(request.resource.data.projectId)
    && validOrderTemplate(request.resource.data.projectId)
    && (
     (request.resource.data.templateType == "cleaning" && validCleaningOrder(request.resource.data.projectId))
     || (request.resource.data.templateType == "carwash" && validCarwashOrder(request.resource.data.projectId))
     || (request.resource.data.templateType == "laundry" && validLaundryOrder(request.resource.data.projectId))
    );
   allow read: if isAdmin() || ownsProject(resource.data.projectId);
   allow update: if (isAdmin() || ownsProject(resource.data.projectId)) && request.resource.data.projectId == resource.data.projectId && request.resource.data.providerId == resource.data.providerId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","laundryStage"]) && request.resource.data.status in ["new","accepted","done","canceled"] && (!("laundryStage" in request.resource.data) || (resource.data.templateType == "laundry" && request.resource.data.laundryStage in ["accepted","picked_up","processing","ready_delivery","delivered"]));
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
  }

  match /carwashSubscriptions/{subscriptionId} {
   allow get: if !exists(/databases/$(database)/documents/carwashSubscriptions/$(subscriptionId)) || isAdmin() || ownsProject(resource.data.projectId) || (resource.data.projectId is string && projectAvailable(resource.data.projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId) && request.resource.data.status == "active" && request.resource.data.totalWashes is number && request.resource.data.remainingWashes is number && request.resource.data.totalWashes > 0 && request.resource.data.remainingWashes == request.resource.data.totalWashes);
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","totalWashes","remainingWashes","startsAt","expiresAt","nextWashDate","preferredTime","intervalDays","cycleNumber","lastWashAt","updatedAt"]) && request.resource.data.remainingWashes is number && request.resource.data.remainingWashes >= 0 && request.resource.data.totalWashes is number && request.resource.data.totalWashes > 0 && request.resource.data.remainingWashes <= request.resource.data.totalWashes);
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
   match /washes/{washId} {
    allow get, list: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId)) || (carwashSubscriptionExists(subscriptionId) && projectAvailable(carwashSubscriptionData(subscriptionId).projectId));
    allow create: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId) && request.resource.data.projectId == carwashSubscriptionData(subscriptionId).projectId && request.resource.data.sequence is number && request.resource.data.sequence > 0);
    allow update, delete: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId));
   }
  }

  match /carwashCustomers/{subscriptionId} {
   allow get: if isAdmin() || (carwashSubscriptionExists(subscriptionId) && ownsProject(carwashSubscriptionData(subscriptionId).projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId));
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId);
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
  }

  match /carwashSubscriptionRequests/{subscriptionId} {
   allow get: if !exists(/databases/$(database)/documents/carwashSubscriptionRequests/$(subscriptionId)) || isAdmin() || ownsProject(resource.data.projectId) || (resource.data.projectId is string && projectAvailable(resource.data.projectId));
   allow list: if isAdmin() || ownsProject(resource.data.projectId);
   allow create: if isAdmin() || (signedIn() && request.resource.data.projectId is string && ownsProject(request.resource.data.projectId)) || (request.resource.data.projectId is string && request.resource.data.status == "pending" && request.resource.data.orderId is string && request.resource.data.requestType in ["new","renewal"] && request.resource.data.keys().hasOnly(["projectId","status","orderId","requestType","updatedAt","createdAt"]) && projectAvailable(request.resource.data.projectId));
   allow update: if isAdmin() || (ownsProject(resource.data.projectId) && request.resource.data.projectId == resource.data.projectId) || (request.resource.data.projectId == resource.data.projectId && request.resource.data.status == "pending" && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","orderId","requestType","updatedAt"]) && request.resource.data.orderId is string && request.resource.data.requestType in ["new","renewal"] && resource.data.status in ["canceled","renewable","active"] && projectAvailable(resource.data.projectId) && (resource.data.status != "active" || (carwashSubscriptionExists(subscriptionId) && (carwashSubscriptionData(subscriptionId).status != "active" || carwashSubscriptionData(subscriptionId).remainingWashes <= 0 || carwashSubscriptionData(subscriptionId).expiresAt <= request.time))));
   allow delete: if isAdmin() || ownsProject(resource.data.projectId);
  }
  match /{document=**} { allow read, write: if false; }
 }
}
