   allow list: if isAdmin()
    || ownsProject(resource.data.projectId)
    || isProjectOperator(resource.data.projectId);

   allow create: if signedIn()
    && request.resource.data.restaurantId == restaurantId
    && request.resource.data.projectId == restaurantId
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.operatorId == restaurantId
    && request.resource.data.currency == "EGP"
    && request.resource.data.deliveryFee is number
    && request.resource.data.deliveryFee >= 0
    && request.resource.data.isAcceptingOrders is bool
    && projectExists(restaurantId)
    && projectData(restaurantId).ownerId == request.auth.uid
    && projectData(restaurantId).template == "restaurant"
    && projectData(restaurantId).operatingModel == "partner_operated"
    && projectData(restaurantId).operatorId == restaurantId
    && operatorExists(restaurantId)
    && operatorData(restaurantId).ownerId == request.auth.uid
    && request.resource.data.keys().hasOnly([
      "restaurantId","projectId","ownerId","operatorId","name","contactName",
      "phone","whatsapp","address","location","cuisine","slogan","logo",
      "coverImage","primaryColor","deliveryFee","currency","isAcceptingOrders",
      "createdAt","updatedAt"
    ]);

   allow update: if (
      isAdmin()
      || isProjectOperator(resource.data.projectId)
      || (
        ownsProject(resource.data.projectId)
        && operatorExists(resource.data.operatorId)
        && operatorData(resource.data.operatorId).isActive == false
      )
    )
    && request.resource.data.restaurantId == resource.data.restaurantId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.deliveryFee is number
    && request.resource.data.deliveryFee >= 0
    && request.resource.data.isAcceptingOrders is bool
    && request.resource.data.primaryColor is string
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "name","contactName","phone","whatsapp","address","location","cuisine",
      "slogan","logo","coverImage","primaryColor","deliveryFee",
      "isAcceptingOrders","updatedAt"
    ]);

   allow delete: if isAdmin();

   match /menu/{itemId} {
    allow get, list: if isAdmin()
     || ownsProject(restaurantId)
     || isProjectOperator(restaurantId)
     || restaurantPartnerReady(restaurantId);

    allow create: if (isAdmin() || isProjectOperator(restaurantId))
     && request.resource.data.itemId == itemId
     && request.resource.data.projectId == restaurantId
     && request.resource.data.name is string
     && request.resource.data.name.size() > 0
     && request.resource.data.category is string
     && request.resource.data.description is string
     && request.resource.data.price is number
     && request.resource.data.price >= 0
     && request.resource.data.image is string
     && request.resource.data.isAvailable is bool
     && request.resource.data.isActive is bool
     && request.resource.data.createdBy == request.auth.uid
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.keys().hasOnly([
       "itemId","projectId","name","category","description","price","image",
       "isAvailable","isActive","createdBy","createdAt","updatedBy","updatedAt"
     ]);

    allow update: if (isAdmin() || isProjectOperator(restaurantId))
     && request.resource.data.itemId == resource.data.itemId
     && request.resource.data.projectId == resource.data.projectId
     && request.resource.data.createdBy == resource.data.createdBy
     && request.resource.data.createdAt == resource.data.createdAt
     && request.resource.data.name is string
     && request.resource.data.name.size() > 0
     && request.resource.data.category is string
     && request.resource.data.description is string
     && request.resource.data.price is number
     && request.resource.data.price >= 0
     && request.resource.data.image is string
     && request.resource.data.isAvailable is bool
     && request.resource.data.isActive is bool
     && request.resource.data.updatedBy == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "name","category","description","price","image","isAvailable",
       "isActive","updatedBy","updatedAt"
     ]);

    allow delete: if isAdmin() || isProjectOperator(restaurantId);
   }
  }

  match /workers/{workerId} {
   allow get, list: if canOperateProject(resource.data.projectId);

   allow create: if signedIn()
    && request.resource.data.workerId == workerId
    && request.resource.data.projectId is string
    && request.resource.data.ownerId is string
    && request.resource.data.templateId is string
    && request.resource.data.name is string
    && request.resource.data.role in ["rider","cleaner","pickup_agent","delivery_agent"]
    && validWorkerRoleForProject(request.resource.data.projectId, request.resource.data.role)
    && request.resource.data.phone is string
    && request.resource.data.whatsapp is string
    && request.resource.data.whatsapp.size() > 0
    && request.resource.data.isActive == true
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.keys().hasOnly([
      "workerId",
      "ownerId",
      "projectId",
      "templateId",
      "name",
      "role",
      "phone",
      "whatsapp",
      "isActive",
      "createdBy",
      "createdAt",
      "updatedAt"
    ])
    && projectExists(request.resource.data.projectId)
    && request.resource.data.ownerId == projectData(request.resource.data.projectId).ownerId
    && request.resource.data.templateId == projectData(request.resource.data.projectId).template
    && canOperateProject(request.resource.data.projectId);

   allow update: if canOperateProject(resource.data.projectId)
    && request.resource.data.workerId == resource.data.workerId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.templateId == resource.data.templateId
    && request.resource.data.createdBy == resource.data.createdBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.name is string
    && request.resource.data.role in ["rider","cleaner","pickup_agent","delivery_agent"]
    && validWorkerRoleForProject(resource.data.projectId, request.resource.data.role)
    && request.resource.data.phone is string
    && request.resource.data.whatsapp is string
    && request.resource.data.whatsapp.size() > 0
    && request.resource.data.isActive is bool
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "name",
      "role",
      "phone",
      "whatsapp",
      "isActive",
      "updatedAt"
    ]);

   allow delete: if isAdmin();
  }

  match /workerAssignments/{assignmentId} {
   allow get, list: if canOperateProject(resource.data.projectId);

   allow create: if signedIn()
    && request.resource.data.assignmentId == assignmentId
    && request.resource.data.projectId is string
    && request.resource.data.orderId is string
    && request.resource.data.workerId is string
    && request.resource.data.actorUid == request.auth.uid
    && request.resource.data.actorType in ["owner","operator"]
    && request.resource.data.eventType in ["assigned","unassigned"]
    && request.resource.data.keys().hasOnly([
      "assignmentId",
      "projectId",
      "orderId",
      "workerId",
      "workerName",
      "workerRole",
      "actorUid",
      "actorType",
      "eventType",
      "createdAt"
    ])
    && orderExists(request.resource.data.orderId)
    && orderData(request.resource.data.orderId).projectId == request.resource.data.projectId
    && (
      (
        request.resource.data.actorType == "owner"
        && ownsProject(request.resource.data.projectId)
        && projectData(request.resource.data.projectId).operatingModel == "owner_operated"
      )
      ||
      (
        request.resource.data.actorType == "operator"
        && isProjectOperator(request.resource.data.projectId)
      )
    )
    && (
      (
        request.resource.data.eventType == "assigned"
        && workerExists(request.resource.data.workerId)
        && workerData(request.resource.data.workerId).projectId == request.resource.data.projectId
        && workerData(request.resource.data.workerId).isActive == true
        && request.resource.data.workerName is string
        && request.resource.data.workerRole == workerData(request.resource.data.workerId).role
      )
      ||
      (
        request.resource.data.eventType == "unassigned"
      )
    );

   allow update, delete: if false;
  }

  match /operators/{operatorId} {
   allow get: if isAdmin()
    || ownsProject(operatorId)
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (signedIn() && resource.data.authUid == request.auth.uid)
    || (
      signedIn()
      && resource.data.authUid == ""
      && (
        (
          resource.data.authLoginEmail is string
          && resource.data.authLoginEmail.size() > 0
          && request.auth.token.email == resource.data.authLoginEmail
        )
        ||
        (
          request.auth.token.email_verified == true
          && request.auth.token.email == resource.data.email
        )
      )
    );

   allow list: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (signedIn() && resource.data.authUid == request.auth.uid);

   allow create: if signedIn()
    && request.resource.data.operatorId == operatorId
    && request.resource.data.projectId == operatorId
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.authUid == ""
    && request.resource.data.authLoginEmail is string
    && request.resource.data.authLoginEmail.size() > 0
    && request.resource.data.status == "pending_invite"
    && request.resource.data.agreementStatus == "not_proposed"
    && request.resource.data.isActive == false
    && projectExists(request.resource.data.projectId)
    && projectData(request.resource.data.projectId).ownerId == request.auth.uid
    && projectData(request.resource.data.projectId).operatingModel == "partner_operated"
    && request.resource.data.templateId == projectData(request.resource.data.projectId).template;

   allow update: if isAdmin()
    || (
      signedIn()
      && resource.data.ownerId == request.auth.uid
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.authUid == resource.data.authUid
      && request.resource.data.status == resource.data.status
      && request.resource.data.isActive == resource.data.isActive
      && (
        resource.data.authUid == ""
        || request.resource.data.email == resource.data.email
      )
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name","contactName","phone","whatsapp","email","authLoginEmail","agreementStatus","updatedAt"])
      && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["authLoginEmail"])
        || (
          resource.data.authUid == ""
          && request.resource.data.authLoginEmail is string
          && request.resource.data.authLoginEmail.size() > 0
        )
      )
      && (
        request.resource.data.agreementStatus == resource.data.agreementStatus
        || (
          resource.data.agreementStatus != "accepted"
          && request.resource.data.agreementStatus == "pending"
        )
      )
    )
    || (
      signedIn()
      && resource.data.authUid == ""
      && (
        (
          resource.data.authLoginEmail is string
          && resource.data.authLoginEmail.size() > 0
          && request.auth.token.email == resource.data.authLoginEmail
        )
        ||
        (
          request.auth.token.email_verified == true
          && request.auth.token.email == resource.data.email
        )
      )
      && request.resource.data.authUid == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["authUid","status","updatedAt"])
      && (
        (resource.data.agreementStatus == "accepted" && request.resource.data.status == "active")
        || (resource.data.agreementStatus != "accepted" && request.resource.data.status == "pending_agreement")
      )
    )
    || (
      signedIn()
      && resource.data.authUid == request.auth.uid
      && request.resource.data.authUid == resource.data.authUid
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["agreementStatus","status","isActive","updatedAt"])
      && (
        (
          request.resource.data.agreementStatus == "accepted"
          && request.resource.data.status == "active"
          && request.resource.data.isActive == true
          && commissionAgreementExists(resource.data.projectId)
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.status == "accepted"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.pendingStatus == "none"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.currentAmount is number
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.acceptedVersion > 0
        )
        || (
          request.resource.data.agreementStatus == "rejected"
          && request.resource.data.status == "pending_agreement"
          && request.resource.data.isActive == false
          && commissionAgreementExists(resource.data.projectId)
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.status == "rejected"
          && getAfter(commissionAgreementPath(resource.data.projectId)).data.pendingStatus == "none"
        )
      )
    );

   allow delete: if isAdmin();
  }

  match /commissionAgreements/{agreementId} {
   allow get: if isAdmin()
    || ownsProject(agreementId)
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
    );

   allow list: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
    );

   allow create: if signedIn()
    && agreementId == request.resource.data.projectId
    && request.resource.data.agreementId == agreementId
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.operatorId == agreementId
    && request.resource.data.currency == "EGP"
    && request.resource.data.unit == "per_completed_order"
    && request.resource.data.currentAmount == null
    && request.resource.data.acceptedVersion == 0
    && request.resource.data.pendingAmount is number
    && request.resource.data.pendingAmount >= 0
    && request.resource.data.status == "pending"
    && request.resource.data.pendingStatus == "pending"
    && request.resource.data.proposedBy == request.auth.uid
    && request.resource.data.version == 1
    && projectExists(request.resource.data.projectId)
    && projectData(request.resource.data.projectId).ownerId == request.auth.uid
    && projectData(request.resource.data.projectId).operatingModel == "partner_operated"
    && request.resource.data.templateId == projectData(request.resource.data.projectId).template
    && operatorExists(request.resource.data.operatorId)
    && operatorData(request.resource.data.operatorId).ownerId == request.auth.uid;

   allow update: if isAdmin()
    || (
      signedIn()
      && resource.data.ownerId == request.auth.uid
      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && request.resource.data.currentAmount == resource.data.currentAmount
      && request.resource.data.acceptedVersion == resource.data.acceptedVersion
      && request.resource.data.pendingAmount is number
      && request.resource.data.pendingAmount >= 0
      && request.resource.data.pendingStatus == "pending"
      && (
        (resource.data.currentAmount != null && request.resource.data.status == "accepted")
        || (resource.data.currentAmount == null && request.resource.data.status == "pending")
      )
      && request.resource.data.proposedBy == request.auth.uid
      && request.resource.data.version == resource.data.version + 1
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingAmount","pendingStatus","status","proposedAt","proposedBy","rejectedAt","updatedAt","version"])
    )
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && resource.data.pendingStatus == "pending"
      && request.resource.data.pendingAmount == null
      && request.resource.data.pendingStatus == "none"
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentAmount","acceptedVersion","pendingAmount","status","pendingStatus","lastDecision","acceptedAt","acceptedBy","rejectedAt","updatedAt"])
      && (
        (
          request.resource.data.lastDecision == "accepted"
          && request.resource.data.status == "accepted"
          && request.resource.data.currentAmount == resource.data.pendingAmount
          && request.resource.data.acceptedVersion == resource.data.version
          && request.resource.data.acceptedBy == request.auth.uid
        )
        || (
          request.resource.data.lastDecision == "rejected"
          && request.resource.data.currentAmount == resource.data.currentAmount
          && request.resource.data.acceptedVersion == resource.data.acceptedVersion
          && (
            (resource.data.currentAmount == null && request.resource.data.status == "rejected")
            || (resource.data.currentAmount != null && request.resource.data.status == "accepted")
          )
        )
      )
    );

   allow delete: if false;
  }


  match /orderTracking/{trackingToken} {
   allow get: if resource.data.trackingToken == trackingToken
    && resource.data.templateType == "supermarket"
    && supermarketPartnerReady(resource.data.projectId);

   allow list: if false;

   allow create: if request.resource.data.trackingToken == trackingToken
    && trackingToken.size() >= 40
    && request.resource.data.templateType == "supermarket"
    && request.resource.data.projectId is string
    && request.resource.data.orderId is string
    && request.resource.data.status == "new"
    && request.resource.data.items is list
    && request.resource.data.subtotal is number
    && request.resource.data.deliveryFee is number
    && request.resource.data.total is number
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt"
    ])
    && supermarketPartnerReady(request.resource.data.projectId)
    && getAfter(orderPath(request.resource.data.orderId)).data.projectId
      == request.resource.data.projectId
    && getAfter(orderPath(request.resource.data.orderId)).data.templateType
      == "supermarket"
    && getAfter(orderPath(request.resource.data.orderId)).data.trackingToken
      == trackingToken
    && getAfter(orderPath(request.resource.data.orderId)).data.status
      == request.resource.data.status
    && getAfter(orderPath(request.resource.data.orderId)).data.items
      == request.resource.data.items
    && getAfter(orderPath(request.resource.data.orderId)).data.subtotal
      == request.resource.data.subtotal
    && getAfter(orderPath(request.resource.data.orderId)).data.deliveryFee
      == request.resource.data.deliveryFee
    && getAfter(orderPath(request.resource.data.orderId)).data.total
      == request.resource.data.total;

   allow update: if (
      isAdmin()
      || isProjectOperator(resource.data.projectId)
    )
    && request.resource.data.trackingToken == resource.data.trackingToken
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.templateType == resource.data.templateType
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.status
      == getAfter(orderPath(resource.data.orderId)).data.status
    && request.resource.data.items
      == getAfter(orderPath(resource.data.orderId)).data.items
    && request.resource.data.subtotal
      == getAfter(orderPath(resource.data.orderId)).data.subtotal
    && request.resource.data.deliveryFee
      == getAfter(orderPath(resource.data.orderId)).data.deliveryFee
    && request.resource.data.total
      == getAfter(orderPath(resource.data.orderId)).data.total
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "updatedAt",
      "deliveredAt"
    ])
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt",
      "deliveredAt"
    ]);

   allow delete: if false;
  }

  match /referrals/{referralId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.referrerUserId == request.auth.uid);
   allow create: if isAdmin();
   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","paidAt"]);
   allow delete: if false;
  }

  match /commissionLedger/{entryId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.userId == request.auth.uid);

   allow create: if isAdmin()
    || (
      signedIn()
      && request.resource.data.sourceType == "project_order"
      && request.resource.data.projectId is string
      && request.resource.data.orderId is string
      && entryId == "project_order_" + request.resource.data.orderId
      && request.resource.data.sourceId == request.resource.data.orderId
      && request.resource.data.agreementId == request.resource.data.projectId
      && request.resource.data.currency == "EGP"
      && request.resource.data.status == "earned"
      && request.resource.data.paidAt == null
      && isProjectOperator(request.resource.data.projectId)
      && projectData(request.resource.data.projectId).template in ["supermarket","laundry","restaurant"]
      && commissionAgreementExists(request.resource.data.projectId)
      && commissionAgreementData(request.resource.data.projectId).status == "accepted"
      && request.resource.data.userId
        == projectData(request.resource.data.projectId).ownerId
      && request.resource.data.amount
        == commissionAgreementData(request.resource.data.projectId).currentAmount
      && request.resource.data.agreementVersion
        == commissionAgreementData(request.resource.data.projectId).acceptedVersion
      && getAfter(orderPath(request.resource.data.orderId)).data.projectId
        == request.resource.data.projectId
      && (
        (
          getAfter(orderPath(request.resource.data.orderId)).data.templateType in ["supermarket","restaurant"]
          && getAfter(orderPath(request.resource.data.orderId)).data.status == "delivered"
        )
        ||
        (
          getAfter(orderPath(request.resource.data.orderId)).data.templateType == "laundry"
          && getAfter(orderPath(request.resource.data.orderId)).data.status == "done"
          && getAfter(orderPath(request.resource.data.orderId)).data.laundryStage == "delivered"
        )
      )
      && getAfter(orderPath(request.resource.data.orderId)).data.commissionLocked
        == true
      && getAfter(orderPath(request.resource.data.orderId)).data.commissionAmount
        == request.resource.data.amount
    );

   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","paidAt"]);

   allow delete: if false;
  }

  match /{document=**} { allow read, write: if false; }
 }
}
