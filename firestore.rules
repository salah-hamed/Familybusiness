      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && request.resource.data.currentAmount == resource.data.currentAmount
      && request.resource.data.acceptedVersion == resource.data.acceptedVersion
      && request.resource.data.pendingAmount is number
      && request.resource.data.pendingAmount >= 0
      && request.resource.data.pendingStatus == "pending"
      && (
        (resource.data.currentAmount != null && request.resource.data.status == "accepted")
        || (resource.data.currentAmount == null && request.resource.data.status == "pending")
      )
      && request.resource.data.proposedBy == request.auth.uid
      && request.resource.data.version == resource.data.version + 1
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["pendingAmount","pendingStatus","status","proposedAt","proposedBy","rejectedAt","updatedAt","version"])
    )
    || (
      signedIn()
      && operatorExists(resource.data.operatorId)
      && operatorData(resource.data.operatorId).authUid == request.auth.uid
      && request.resource.data.agreementId == resource.data.agreementId
      && request.resource.data.projectId == resource.data.projectId
      && request.resource.data.ownerId == resource.data.ownerId
      && request.resource.data.operatorId == resource.data.operatorId
      && request.resource.data.templateId == resource.data.templateId
      && request.resource.data.currency == resource.data.currency
      && request.resource.data.unit == resource.data.unit
      && resource.data.pendingStatus == "pending"
      && request.resource.data.pendingAmount == null
      && request.resource.data.pendingStatus == "none"
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["currentAmount","acceptedVersion","pendingAmount","status","pendingStatus","lastDecision","acceptedAt","acceptedBy","rejectedAt","updatedAt"])
      && (
        (
          request.resource.data.lastDecision == "accepted"
          && request.resource.data.status == "accepted"
          && request.resource.data.currentAmount == resource.data.pendingAmount
          && request.resource.data.acceptedVersion == resource.data.version
          && request.resource.data.acceptedBy == request.auth.uid
          && (
            !userExists(resource.data.ownerId)
            || !("accessModel" in userData(resource.data.ownerId))
            || userData(resource.data.ownerId).accessModel != "merchant_trial_v1"
            || userData(resource.data.ownerId).subscriptionStatus != "trial"
            || userData(resource.data.ownerId).firstMerchantLinkedAt != null
            || (
              existsAfter(userPath(resource.data.ownerId))
              && getAfter(userPath(resource.data.ownerId)).data.firstMerchantLinkedAt == request.time
              && getAfter(userPath(resource.data.ownerId)).data.firstMerchantProjectId == resource.data.projectId
            )
          )
        )
        || (
          request.resource.data.lastDecision == "rejected"
          && request.resource.data.currentAmount == resource.data.currentAmount
          && request.resource.data.acceptedVersion == resource.data.acceptedVersion
          && (
            (resource.data.currentAmount == null && request.resource.data.status == "rejected")
            || (resource.data.currentAmount != null && request.resource.data.status == "accepted")
          )
        )
      )
    );

   allow delete: if false;
  }


  match /orderTracking/{trackingToken} {
   allow get: if resource.data.trackingToken == trackingToken
    && resource.data.templateType in ["supermarket","restaurant","bakery","laundry"]
    && trackingTemplateReady(resource.data.projectId, resource.data.templateType);

   allow list: if false;

   allow create: if request.resource.data.trackingToken == trackingToken
    && trackingToken.size() >= 40
    && request.resource.data.templateType in ["supermarket","restaurant","bakery","laundry"]
    && request.resource.data.projectId is string
    && request.resource.data.orderId is string
    && request.resource.data.status == "new"
    && request.resource.data.items is list
    && request.resource.data.subtotal is number
    && request.resource.data.deliveryFee is number
    && request.resource.data.total is number
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt"
    ])
    && trackingTemplateReady(
      request.resource.data.projectId,
      request.resource.data.templateType
    )
    && getAfter(orderPath(request.resource.data.orderId)).data.projectId
      == request.resource.data.projectId
    && getAfter(orderPath(request.resource.data.orderId)).data.templateType
      == request.resource.data.templateType
    && getAfter(orderPath(request.resource.data.orderId)).data.trackingToken
      == trackingToken
    && getAfter(orderPath(request.resource.data.orderId)).data.status
      == request.resource.data.status
    && getAfter(orderPath(request.resource.data.orderId)).data.items
      == request.resource.data.items
    && (
      request.resource.data.templateType == "laundry"
      ? (
        request.resource.data.subtotal == getAfter(orderPath(request.resource.data.orderId)).data.price
        && request.resource.data.deliveryFee == 0
        && request.resource.data.total == getAfter(orderPath(request.resource.data.orderId)).data.price
      )
      : (
        getAfter(orderPath(request.resource.data.orderId)).data.subtotal
          == request.resource.data.subtotal
        && getAfter(orderPath(request.resource.data.orderId)).data.deliveryFee
          == request.resource.data.deliveryFee
        && getAfter(orderPath(request.resource.data.orderId)).data.total
          == request.resource.data.total
      )
    );

   function validLaundryTrackingUpdate(){
    let nextOrder = getAfter(orderPath(resource.data.orderId)).data;
    return (
      isAdmin()
      || isProjectOperator(resource.data.projectId)
    )
    && request.resource.data.trackingToken == resource.data.trackingToken
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.templateType == "laundry"
    && request.resource.data.createdAt == resource.data.createdAt
    && nextOrder.projectId == resource.data.projectId
    && nextOrder.templateType == "laundry"
    && request.resource.data.status == laundryTrackingStatus(nextOrder)
    && request.resource.data.items == nextOrder.items
    && request.resource.data.subtotal == nextOrder.price
    && request.resource.data.deliveryFee == 0
    && request.resource.data.total == nextOrder.price
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "updatedAt",
      "deliveredAt"
    ])
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt",
      "deliveredAt"
    ]);
   }

   allow update: if resource.data.templateType == "laundry"
    && validLaundryTrackingUpdate();

   allow update: if resource.data.templateType != "laundry"
    && (
      isAdmin()
      || isProjectOperator(resource.data.projectId)
    )
    && request.resource.data.trackingToken == resource.data.trackingToken
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.templateType == resource.data.templateType
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.status
      == (
        resource.data.templateType == "laundry"
        ? laundryTrackingStatus(getAfter(orderPath(resource.data.orderId)).data)
        : getAfter(orderPath(resource.data.orderId)).data.status
      )
    && request.resource.data.items
      == getAfter(orderPath(resource.data.orderId)).data.items
    && (
      resource.data.templateType == "laundry"
      ? (
        request.resource.data.subtotal == getAfter(orderPath(resource.data.orderId)).data.price
        && request.resource.data.deliveryFee == 0
        && request.resource.data.total == getAfter(orderPath(resource.data.orderId)).data.price
      )
      : (
        request.resource.data.subtotal == getAfter(orderPath(resource.data.orderId)).data.subtotal
        && request.resource.data.deliveryFee == getAfter(orderPath(resource.data.orderId)).data.deliveryFee
        && request.resource.data.total == getAfter(orderPath(resource.data.orderId)).data.total
      )
    )
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "updatedAt",
      "deliveredAt"
    ])
    && request.resource.data.keys().hasOnly([
      "trackingToken",
      "orderId",
      "projectId",
      "templateType",
      "status",
      "items",
      "subtotal",
      "deliveryFee",
      "total",
      "createdAt",
      "updatedAt",
      "deliveredAt"
    ]);
   allow delete: if false;
  }

  match /referrals/{referralId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.referrerUserId == request.auth.uid);
   allow create: if isAdmin();
   allow update: if isAdmin()
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status","paidAt"]);
   allow delete: if false;
  }

  match /commissionLedger/{entryId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.userId == request.auth.uid)
    || (
      signedIn()
      && resource.data.sourceType == "project_order"
      && resource.data.projectId is string
      && isProjectOperator(resource.data.projectId)
    );

   allow create: if isAdmin()
    || validTrackedLaundryProjectOrderLedgerCreate(entryId)
    || validProjectOrderLedgerCreate(entryId);

   allow update: if (
    isAdmin()
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.sourceType == resource.data.sourceType
    && request.resource.data.sourceId == resource.data.sourceId
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "paidAt",
      "settlementId",
      "settlementStatus",
      "settlementCreatedAt"
    ])
   )
   ||
   (
    signedIn()
    && resource.data.sourceType == "project_order"
    && resource.data.userId == request.auth.uid
    && resource.data.status == "earned"
    && request.resource.data.status == "reversed"
    && request.resource.data.userId == resource.data.userId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.sourceType == resource.data.sourceType
    && request.resource.data.sourceId == resource.data.sourceId
    && request.resource.data.agreementId == resource.data.agreementId
    && request.resource.data.agreementVersion == resource.data.agreementVersion
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.reversedAt == request.time
    && request.resource.data.reversalId == "project_order_" + resource.data.orderId
    && request.resource.data.reversalConfirmedBy == request.auth.uid
    && exists(commissionReversalPath(request.resource.data.reversalId))
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.status == "confirmed"
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.ownerId == request.auth.uid
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.projectId == resource.data.projectId
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.orderId == resource.data.orderId
    && getAfter(commissionReversalPath(request.resource.data.reversalId)).data.amount == resource.data.amount
    && request.resource.data.reversalReason
      == getAfter(commissionReversalPath(request.resource.data.reversalId)).data.reasonCode
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "reversedAt",
      "reversalId",
      "reversalReason",
      "reversalConfirmedBy"
    ])
   );

   allow delete: if false;
  }

  match /commissionReversals/{reversalId} {
   allow get, list: if isAdmin()
    || (
      signedIn()
      && resource.data.projectId is string
      && (
        ownsProject(resource.data.projectId)
        || isProjectOperator(resource.data.projectId)
      )
    );

   allow create: if signedIn()
    && request.resource.data.reversalId == reversalId
    && request.resource.data.orderId is string
    && request.resource.data.projectId is string
    && reversalId == "project_order_" + request.resource.data.orderId
    && request.resource.data.ledgerEntryId == "project_order_" + request.resource.data.orderId
    && isProjectOperator(request.resource.data.projectId)
    && projectExists(request.resource.data.projectId)
    && orderExists(request.resource.data.orderId)
    && exists(commissionLedgerPath(request.resource.data.ledgerEntryId))
    && request.resource.data.ownerId == projectData(request.resource.data.projectId).ownerId
    && request.resource.data.operatorId == projectData(request.resource.data.projectId).operatorId
    && request.resource.data.requestedBy == request.auth.uid
    && request.resource.data.currency == "EGP"
    && request.resource.data.amount is number
    && request.resource.data.amount > 0
    && request.resource.data.status == "pending_owner_confirmation"
    && request.resource.data.reasonCode in [
      "customer_canceled_after_dispatch",
      "delivery_failed",
      "duplicate_order",
      "operator_error",
      "other"
    ]
    && request.resource.data.createdAt == request.time
    && request.resource.data.requestedAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.confirmedAt == null
    && request.resource.data.confirmedBy == null
    && request.resource.data.rejectedAt == null
    && request.resource.data.rejectedBy == null
    && orderData(request.resource.data.orderId).projectId == request.resource.data.projectId
    && orderData(request.resource.data.orderId).status == "canceled"
    && orderData(request.resource.data.orderId).commissionLocked == true
    && orderData(request.resource.data.orderId).commissionAmount == request.resource.data.amount
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.projectId
      == request.resource.data.projectId
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.orderId
      == request.resource.data.orderId
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.amount
      == request.resource.data.amount
    && get(commissionLedgerPath(request.resource.data.ledgerEntryId)).data.status == "earned";

   allow update: if signedIn()
    && resource.data.projectId is string
    && ownsProject(resource.data.projectId)
    && resource.data.ownerId == request.auth.uid
    && resource.data.status == "pending_owner_confirmation"
    && request.resource.data.reversalId == resource.data.reversalId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.orderId == resource.data.orderId
    && request.resource.data.ledgerEntryId == resource.data.ledgerEntryId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.reasonCode == resource.data.reasonCode
    && request.resource.data.note == resource.data.note
    && request.resource.data.requestedAt == resource.data.requestedAt
    && request.resource.data.requestedBy == resource.data.requestedBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "confirmedAt",
      "confirmedBy",
      "rejectedAt",
      "rejectedBy",
      "updatedAt"
    ])
    && (
      (
        request.resource.data.status == "confirmed"
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.rejectedAt == null
        && request.resource.data.rejectedBy == null
      )
      ||
      (
        request.resource.data.status == "rejected"
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
      )
    );

   allow delete: if false;
  }

  function merchantCycleOfProject(projectId){
   let p=projectData(projectId);
   return ("assignmentCycle" in p)?p.assignmentCycle:1;
  }
  function authorizedMerchantCycleReceiptSubscriber(projectId,cycle,uid){
    let p=projectData(projectId);
    return signedIn() && uid==request.auth.uid
     && (
       (p.platformManaged==true
        && p.assignmentStatus=="assigned_to_new_subscriber"
        && p.assignedSubscriberId==uid
        && merchantCycleOfProject(projectId)==cycle
        && isVerifiedAssignedAfterCutover(projectId))
       || (
        exists(merchantHistoricGrantPath(projectId+"_"+uid))
        && get(merchantHistoricGrantPath(projectId+"_"+uid)).data.status=="historic_only"
        && get(merchantHistoricGrantPath(projectId+"_"+uid)).data.firstRecoveredCycle==cycle+1
        && get(merchantHistoricGrantPath(projectId+"_"+uid)).data.subscriberUid==uid
       )
     );
  }
  function validMerchantCycleSettlementCreate(settlementId){
   let d=request.resource.data;
   let p=projectData(d.projectId);
   let period=d.projectId+"_"+string(d.assignmentCycle);
   let state=getAfter(/databases/$(database)/documents/merchantCyclePaymentStates/$(period)).data;
   return signedIn()
    && d.settlementId==settlementId
    && d.assignmentCycle is int && d.assignmentCycle>=1
    && d.assignmentCycle==merchantCycleOfProject(d.projectId)
    && p.platformManaged==true
    && p.assignmentStatus=="assigned_to_new_subscriber"
    && isVerifiedAssignedAfterCutover(d.projectId)
    && d.ownerId==p.assignedSubscriberId
    && d.operatorId==p.operatorId
    && isProjectOperator(d.projectId)
    && d.declaredBy==request.auth.uid
    && d.status=="pending_owner_confirmation"
    && d.currency=="EGP" && d.amount is number && d.amount>0
    && d.paymentMethod in ["instapay","bank_transfer","cash","other"]
    && d.paymentReference is string && d.paymentReference.size()<=200
    && d.note is string && d.note.size()<=500
    && d.createdAt==request.time && d.declaredAt==request.time
    && d.updatedAt==request.time
    && d.confirmedAt==null && d.confirmedBy==null
    && d.rejectedAt==null && d.rejectedBy==null
    && state.projectId==d.projectId
    && state.assignmentCycle==d.assignmentCycle
    && state.beneficiaryId==d.ownerId
    && state.pendingSettlementId==settlementId
    && state.updatedAt==request.time
    && d.keys().hasOnly([
     "settlementId","projectId","ownerId","operatorId","assignmentCycle",
     "templateId","businessName","currency","amount","status",
     "paymentMethod","paymentReference","note","declaredAt","declaredBy",
     "createdAt","updatedAt","confirmedAt","confirmedBy","rejectedAt","rejectedBy"]);
  }
  function validMerchantCycleSettlementDecision(settlementId){
   let old=resource.data;
   let next=request.resource.data;
   let state=getAfter(/databases/$(database)/documents/merchantCyclePaymentStates/$(old.projectId+"_"+string(old.assignmentCycle))).data;
   return signedIn()
    && ("assignmentCycle" in old)
    && old.assignmentCycle is int && old.assignmentCycle>=1
    && old.status=="pending_owner_confirmation"
    && authorizedMerchantCycleReceiptSubscriber(old.projectId,old.assignmentCycle,old.ownerId)
    && next.diff(old).affectedKeys().hasOnly([
      "status","confirmedAt","confirmedBy","rejectedAt","rejectedBy","updatedAt"
    ])
    && next.updatedAt==request.time
    && (
      (next.status=="confirmed"
       && next.confirmedAt==request.time && next.confirmedBy==request.auth.uid
       && next.rejectedAt==null && next.rejectedBy==null)
      || (next.status=="rejected"
       && next.rejectedAt==request.time && next.rejectedBy==request.auth.uid
       && next.confirmedAt==null && next.confirmedBy==null)
    )
    && state.projectId==old.projectId
    && state.assignmentCycle==old.assignmentCycle
    && state.pendingSettlementId==""
    && state.updatedAt==request.time;
  }
  match /commissionSettlements/{settlementId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.ownerId == request.auth.uid)
    || (
      signedIn()
      && resource.data.projectId is string
      && (
        (ownsProject(resource.data.projectId) && resource.data.ownerId == request.auth.uid)
        || (
          historicProjectOwner(resource.data.projectId)
          && resource.data.ownerId == request.auth.uid
        )
        || isProjectOperator(resource.data.projectId)
      )
    );

   allow create: if validMerchantCycleSettlementCreate(settlementId)
    || (signedIn()
    && request.resource.data.settlementId == settlementId
    && request.resource.data.projectId is string
    && isProjectOperator(request.resource.data.projectId)
    && projectExists(request.resource.data.projectId)
    && (!("platformManaged" in projectData(request.resource.data.projectId))
       || projectData(request.resource.data.projectId).platformManaged == false)
    && request.resource.data.ownerId == projectData(request.resource.data.projectId).ownerId
    && request.resource.data.operatorId == projectData(request.resource.data.projectId).operatorId
    && request.resource.data.declaredBy == request.auth.uid
    && request.resource.data.amount is number
    && request.resource.data.amount > 0
    && request.resource.data.currency == "EGP"
    && request.resource.data.status == "pending_owner_confirmation"
    && request.resource.data.createdAt == request.time
    && request.resource.data.declaredAt == request.time
    && request.resource.data.updatedAt == request.time
    && request.resource.data.confirmedAt == null
    && request.resource.data.confirmedBy == null
    && request.resource.data.rejectedAt == null
    && request.resource.data.rejectedBy == null);

   allow update: if validMerchantCycleSettlementDecision(settlementId);
   allow update: if signedIn()
    && resource.data.projectId is string
    && historicProjectOwner(resource.data.projectId)
    && resource.data.ownerId == request.auth.uid
    && resource.data.status == "pending_owner_confirmation"
    && request.resource.data.settlementId == resource.data.settlementId
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.templateId == resource.data.templateId
    && request.resource.data.businessName == resource.data.businessName
    && request.resource.data.currency == resource.data.currency
    && request.resource.data.amount == resource.data.amount
    && request.resource.data.paymentMethod == resource.data.paymentMethod
    && request.resource.data.paymentReference == resource.data.paymentReference
    && request.resource.data.note == resource.data.note
    && request.resource.data.declaredAt == resource.data.declaredAt
    && request.resource.data.declaredBy == resource.data.declaredBy
    && request.resource.data.createdAt == resource.data.createdAt
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "status",
      "confirmedAt",
      "confirmedBy",
      "rejectedAt",
      "rejectedBy",
      "updatedAt"
    ])
    && (
      (
        request.resource.data.status == "confirmed"
        && request.resource.data.confirmedAt == request.time
        && request.resource.data.confirmedBy == request.auth.uid
        && request.resource.data.rejectedAt == null
        && request.resource.data.rejectedBy == null
      )
      ||
      (
        request.resource.data.status == "rejected"
        && request.resource.data.rejectedAt == request.time
        && request.resource.data.rejectedBy == request.auth.uid
        && request.resource.data.confirmedAt == null
        && request.resource.data.confirmedBy == null
      )
    );

   allow delete: if false;
  }

  match /merchantCyclePaymentStates/{periodId} {
    function validNewPendingState(){
     let d=request.resource.data;
     let payment=getAfter(commissionSettlementPath(d.pendingSettlementId)).data;
     return signedIn()
      && periodId==d.projectId+"_"+string(d.assignmentCycle)
      && d.assignmentCycle is int && d.assignmentCycle>=1
      && merchantCycleOfProject(d.projectId)==d.assignmentCycle
      && isProjectOperator(d.projectId)
      && d.beneficiaryId==projectData(d.projectId).assignedSubscriberId
      && d.operatorId==projectData(d.projectId).operatorId
      && d.pendingSettlementId is string && d.pendingSettlementId.size()>0
      && d.updatedAt==request.time
      && payment.status=="pending_owner_confirmation"
      && payment.projectId==d.projectId
      && payment.assignmentCycle==d.assignmentCycle
      && payment.ownerId==d.beneficiaryId
      && payment.declaredBy==request.auth.uid
      && payment.createdAt==request.time
      && d.keys().hasOnly([
       "projectId","assignmentCycle","beneficiaryId","operatorId",
       "pendingSettlementId","updatedAt"]);
    }
    function validClearPendingState(){
     let old=resource.data;
     let next=request.resource.data;
     let payment=getAfter(commissionSettlementPath(old.pendingSettlementId)).data;
     return signedIn()
      && old.pendingSettlementId is string && old.pendingSettlementId.size()>0
      && authorizedMerchantCycleReceiptSubscriber(old.projectId,old.assignmentCycle,old.beneficiaryId)
      && next.pendingSettlementId=="" && next.updatedAt==request.time
      && next.diff(old).affectedKeys().hasOnly(["pendingSettlementId","updatedAt"])
      && payment.ownerId==request.auth.uid
      && payment.status in ["confirmed","rejected"]
      && (payment.confirmedBy==request.auth.uid || payment.rejectedBy==request.auth.uid)
      && payment.updatedAt==request.time;
    }
    allow get: if isAdmin() || isProjectOperator(resource.data.projectId)
      || authorizedMerchantCycleReceiptSubscriber(resource.data.projectId,resource.data.assignmentCycle,resource.data.beneficiaryId);
    allow list: if isAdmin();
    allow create: if validNewPendingState();
    allow update: if (
      resource.data.pendingSettlementId==""
      && request.resource.data.pendingSettlementId!=""
      && validNewPendingState()
    ) || validClearPendingState();
    allow delete: if false;
  }
  match /commissionPaymentStates/{projectId} {
   allow get, list: if isAdmin()
    || historicProjectOwner(projectId)
    || isProjectOperator(projectId);

   allow create: if signedIn()
    && (
      (ownsProject(projectId) && projectData(projectId).ownerId == request.auth.uid)
      || isProjectOperator(projectId)
      || (
        historicProjectOwner(projectId)
        && resource.data.pendingSettlementId is string
        && resource.data.pendingSettlementId.size() > 0
        && request.resource.data.pendingSettlementId == ""
        && exists(commissionSettlementPath(resource.data.pendingSettlementId))
        && get(commissionSettlementPath(resource.data.pendingSettlementId)).data.ownerId == request.auth.uid
        && getAfter(commissionSettlementPath(resource.data.pendingSettlementId)).data.status in ["confirmed","rejected"]
        && (
          getAfter(commissionSettlementPath(resource.data.pendingSettlementId)).data.confirmedBy == request.auth.uid
          || getAfter(commissionSettlementPath(resource.data.pendingSettlementId)).data.rejectedBy == request.auth.uid
        )
      )
    )
    && request.resource.data.projectId == projectId
    && request.resource.data.ownerId == projectData(projectId).ownerId
    && request.resource.data.operatorId == projectData(projectId).operatorId
    && request.resource.data.pendingSettlementId is string
    && request.resource.data.updatedAt == request.time
    && request.resource.data.keys().hasOnly([
      "projectId",
      "ownerId",
      "operatorId",
      "pendingSettlementId",
      "updatedAt"
    ]);

   allow update: if signedIn()
    && ((ownsProject(projectId) && resource.data.ownerId == request.auth.uid) || isProjectOperator(projectId))
    && request.resource.data.projectId == resource.data.projectId
    && request.resource.data.ownerId == resource.data.ownerId
    && request.resource.data.operatorId == resource.data.operatorId
    && request.resource.data.pendingSettlementId is string
    && request.resource.data.updatedAt == request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      "pendingSettlementId",
      "updatedAt"
    ]);

   allow delete: if false;
  }

  // A documented admin decision is required; a raw subscriber complaint alone
  // must never make an operator shop recoverable.
  match /merchantViolations/{projectId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin()
    && projectExists(projectId)
    && request.resource.data.projectDocId == projectId
    && request.resource.data.status == "confirmed"
    && request.resource.data.reasonCode is string
    && request.resource.data.reasonCode.matches('^[a-z][a-z0-9_]{2,63}$')
    && request.resource.data.evidenceReference is string
    && request.resource.data.evidenceReference.size() >= 8
    && request.resource.data.evidenceReference.size() <= 200
    && request.resource.data.confirmedByAdminUid == request.auth.uid
    && request.resource.data.confirmedAt == request.time
    && request.resource.data.keys().hasOnly([
      "projectDocId","status","reasonCode","evidenceReference",
      "confirmedByAdminUid","confirmedAt"
    ]);
   allow update, delete: if false;
  }

  function validVerifiedRecoveryCause(projectId, reason, evidenceRef) {
   let subscriber = userData(projectData(projectId).assignedSubscriberId);
   return userExists(projectData(projectId).assignedSubscriberId)
    && (
     (
       reason == "overdue_renewal"
       && subscriber.initialActivationPaid == true
       && subscriber.subscriptionExpiresAt is timestamp
       && subscriber.subscriptionExpiresAt <= request.time
     )
     || (
       reason == "unpaid_first_month"
       && subscriber.accessModel == "merchant_trial_v1"
       && subscriber.firstMerchantLinkedAt is timestamp
       && subscriber.firstMerchantLinkedAt + duration.value(3, 'd') <= request.time
       && subscriber.initialActivationPaid == false
       && subscriber.subscriptionStatus == "trial"
       && !("lastSubscriptionPaymentId" in subscriber)
     )
     || (
       reason == "confirmed_violation"
       && exists(merchantViolationPath(projectId))
       && get(merchantViolationPath(projectId)).data.status == "confirmed"
       && get(merchantViolationPath(projectId)).data.evidenceReference == evidenceRef
     )
    );
  }

  // Immutable recovery audit must be written atomically with platform handover.
  match /merchantRecoveries/{projectId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin()
    && projectExists(projectId)
    && exists(billingGuardPath(projectData(projectId).assignedSubscriberId))
    && get(billingGuardPath(projectData(projectId).assignedSubscriberId)).data.userId==projectData(projectId).assignedSubscriberId
    && get(billingGuardPath(projectData(projectId).assignedSubscriberId)).data.recoverySafe==true
    && get(billingGuardPath(projectData(projectId).assignedSubscriberId)).data.pendingPaymentId==""
    && request.resource.data.recoveryId == projectId
    && request.resource.data.projectDocId == projectId
    && request.resource.data.merchantId == projectData(projectId).merchantId
    && request.resource.data.originalSubscriberId == projectData(projectId).originalSubscriberId
    && request.resource.data.previousSubscriberId == projectData(projectId).assignedSubscriberId
    && request.resource.data.reason in ["overdue_renewal","unpaid_first_month","confirmed_violation"]
    && validVerifiedRecoveryCause(projectId,request.resource.data.reason,request.resource.data.evidenceReference)
    && request.resource.data.evidenceReference is string
    && request.resource.data.evidenceReference.size() >= 8
    && request.resource.data.evidenceReference.size() <= 200
    && request.resource.data.status == "completed"
    && request.resource.data.adminUid == request.auth.uid
    && request.resource.data.recoveredAt == request.time
    && request.resource.data.keys().hasOnly([
      "recoveryId","projectDocId","merchantId","originalSubscriberId",
      "previousSubscriberId","reason","evidenceReference","status","adminUid","recoveredAt"
    ])
    && existsAfter(projectPath(projectId))
    && getAfter(projectPath(projectId)).data.platformManaged == true
    && getAfter(projectPath(projectId)).data.assignmentStatus == "platform_managed"
    && getAfter(projectPath(projectId)).data.assignedSubscriberId == ""
    && getAfter(projectPath(projectId)).data.recoveryAuditId == projectId
    && getAfter(projectPath(projectId)).data.recoveryAt == request.time
    && getAfter(projectPath(projectId)).data.recoveryReason == request.resource.data.reason;
   allow update, delete: if false;
  }

  // Transfer-consent records are NOT an authorization transfer.
  // A later independently reviewed cutover must protect historical ledgers
  // and preserve the existing projectDocId/ownerId runtime identity.
  // Use each referenced document once: Firestore enforces a 10-read
  // access budget per single write. Repeating get()/exists() in a
  // transferred shop's audit check can otherwise deny valid consent cases.
  function validMerchantTransferCaseCreate(projectId){
   let p = get(projectPath(projectId)).data;
   let op = get(operatorPath(projectId)).data;
   let agreement = get(commissionAgreementPath(projectId)).data;
   let audit = get(merchantRecoveryPath(projectId)).data;
   let d = request.resource.data;
   return p.operatingModel == "partner_operated"
    && p.template in ["supermarket","restaurant","bakery","laundry"]
    && p.platformManaged == true
    && p.assignmentStatus == "platform_managed"
    && p.assignedSubscriberId == ""
    && p.operatorId == projectId
    && p.recoveryAuditId == projectId
    && p.recoveryAt is timestamp
    && p.merchantId.matches('^m_[0-9a-f]{32}$')
    && audit.status == "completed"
    && audit.recoveryId == projectId
    && audit.projectDocId == projectId
    && audit.merchantId == p.merchantId
    && audit.originalSubscriberId == p.originalSubscriberId
    && audit.previousSubscriberId == p.originalSubscriberId
    && audit.adminUid == p.recoveryAdminUid
    && audit.recoveredAt == p.recoveryAt
    && op.authUid is string
    && op.authUid.size() > 0
    && op.agreementStatus == "accepted"
    && op.isActive == true
    && agreement.status == "accepted"
    && agreement.acceptedVersion > 0
    && d.projectDocId == projectId
    && d.merchantId == p.merchantId
    && d.originalSubscriberId == p.originalSubscriberId
    && d.previousSubscriberId == ""
    && d.proposedSubscriberId is string
    && d.proposedSubscriberId.size() > 0
    && d.proposedSubscriberId.size() <= 128
    && d.proposedSubscriberId != d.originalSubscriberId
    && subscriptionActive(d.proposedSubscriberId)
    && d.status == "awaiting_consents"
    && d.operatorConsent == "pending"
    && d.recipientConsent == "pending"
    && d.operatorConsentedAt == null
    && d.recipientConsentedAt == null
    && agreement.currentAmount is number
    && agreement.currentAmount >= 0
    && agreement.currency == "EGP"
    && d.commissionAmount == agreement.currentAmount
    && d.commissionVersion == agreement.acceptedVersion
    && d.commissionCurrency == agreement.currency
    && d.financeClearance == "pending"
    && d.cutoverAt == null
    && d.reason is string
    && d.reason.size() >= 15
    && d.reason.size() <= 300
    && d.createdBy == request.auth.uid
    && d.createdAt == request.time
    && d.keys().hasOnly([
      "projectDocId","merchantId","originalSubscriberId","previousSubscriberId",
      "proposedSubscriberId","status","operatorConsent","recipientConsent",
      "operatorConsentedAt","recipientConsentedAt","financeClearance","cutoverAt",
      "commissionAmount","commissionVersion","commissionCurrency",
      "reason","createdBy","createdAt"
    ]);
  }

  match /merchantTransferCases/{projectId} {
   allow get: if isAdmin() || (
      signedIn()
      && (
        resource.data.proposedSubscriberId == request.auth.uid
        || (operatorExists(projectId) && operatorData(projectId).authUid == request.auth.uid)
      )
   );
   allow list: if isAdmin();

   allow create: if isAdmin() && validMerchantTransferCaseCreate(projectId);

   function validAtomicMerchantConsentFinalize(projectId){
     let before=resource.data;
     let next=request.resource.data;
     let witness=getAfter(merchantCutoverPath(projectId)).data;
     return isAdmin()
      && before.status == "awaiting_consents"
      && before.financeClearance == "reviewed"
      && before.operatorConsent == "accepted"
      && before.recipientConsent == "accepted"
      && next.status == "cutover_completed"
      && next.cutoverAt == request.time
      && next.cutoverBy == request.auth.uid
      && next.cutoverAuditId == projectId
      && subscriptionActive(before.proposedSubscriberId)
      && witness.status == "completed"
      && witness.assignedSubscriberId == before.proposedSubscriberId
      && witness.completedAt == request.time
      && next.diff(before).affectedKeys().hasOnly([
       "status","cutoverAt","cutoverBy","cutoverAuditId"
      ]);
   }
   // Only the claimed physical merchant operator may record their own consent.
   allow update: if (
     signedIn()
     && operatorExists(projectId)
     && operatorData(projectId).authUid == request.auth.uid
     && resource.data.status == "awaiting_consents"
     && resource.data.operatorConsent == "pending"
     && request.resource.data.operatorConsent in ["accepted","declined"]
     && request.resource.data.operatorConsentedAt == request.time
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "operatorConsent","operatorConsentedAt"
     ])
   ) || (
     signedIn()
     && resource.data.proposedSubscriberId == request.auth.uid
     && resource.data.status == "awaiting_consents"
     && resource.data.recipientConsent == "pending"
     && request.resource.data.recipientConsent in ["accepted","declined"]
     && request.resource.data.recipientConsentedAt == request.time
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "recipientConsent","recipientConsentedAt"
     ])
   ) || (
     // Admin reviews finance statements; NOT a payment confirmation.
     isAdmin()
     && resource.data.status == "awaiting_consents"
     && resource.data.operatorConsent == "accepted"
     && resource.data.recipientConsent == "accepted"
     && resource.data.financeClearance == "pending"
     && request.resource.data.financeClearance == "reviewed"
     && request.resource.data.financeReviewedBy == request.auth.uid
     && request.resource.data.financeReviewedAt == request.time
     && existsAfter(merchantTransferFinanceReviewPath(projectId))
     && getAfter(merchantTransferFinanceReviewPath(projectId)).data.adminUid == request.auth.uid
     && getAfter(merchantTransferFinanceReviewPath(projectId)).data.reviewedAt == request.time
     && getAfter(merchantTransferFinanceReviewPath(projectId)).data.projectDocId == projectId
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "financeClearance","financeReviewedBy","financeReviewedAt"
     ])
   ) || (
     validAtomicMerchantConsentFinalize(projectId)
   ) || (
     isAdmin()
     && resource.data.status == "awaiting_consents"
     && request.resource.data.status == "canceled"
     && request.resource.data.canceledBy == request.auth.uid
     && request.resource.data.canceledAt == request.time
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
       "status","canceledBy","canceledAt"
     ])
   );
   allow delete: if false;
  }


  // Financial snapshot is PRIVATE: consent case readers must never see a
  // former subscriber's outstanding balances. Reviewed is not paid.
   // C4B11: admin-private witness for the sole platform->subscriber cutover.
   // No ledger row or historical settlement is ever rewritten.
   match /merchantAssignmentCutovers/{projectId} {
    // Cache every read in one evaluation rather than repeatedly dereferencing
    // the same six documents. Firestore has a 1000-expression evaluation limit.
    function validCutoverAuditCreate(projectId){
     let p = get(projectPath(projectId)).data;
     let c = get(merchantTransferCasePath(projectId)).data;
     let review = get(merchantTransferFinanceReviewPath(projectId)).data;
     let recovery = get(merchantRecoveryPath(projectId)).data;
     let op = get(operatorPath(projectId)).data;
     let agreement = get(commissionAgreementPath(projectId)).data;
     let afterProject = getAfter(projectPath(projectId)).data;
     let afterCase = getAfter(merchantTransferCasePath(projectId)).data;
     let d = request.resource.data;
     return p.platformManaged == true
      && p.assignmentStatus == "platform_managed"
      && p.assignedSubscriberId == ""
      && p.operatorId == projectId
      && p.recoveryAuditId == projectId
      && recovery.status == "completed"
      && recovery.projectDocId == projectId
      && recovery.merchantId == p.merchantId
      && op.authUid is string
      && op.authUid.size() > 0
      && op.isActive == true
      && op.status == "active"
      && op.agreementStatus == "accepted"
      && agreement.status == "accepted"
      && agreement.ownerId == p.ownerId
      && agreement.currency == "EGP"
      && agreement.currentAmount == c.commissionAmount
      && agreement.acceptedVersion == c.commissionVersion
      && c.status == "awaiting_consents"
      && c.financeClearance == "reviewed"
      && c.operatorConsent == "accepted"
      && c.recipientConsent == "accepted"
      && review.projectDocId == projectId
      && review.formerSubscriberId == p.originalSubscriberId
      && review.reviewedAt == c.financeReviewedAt
      && subscriptionActive(c.proposedSubscriberId)
      && d.projectDocId == projectId
      && d.merchantId == p.merchantId
      && d.originalSubscriberId == p.originalSubscriberId
      && d.previousSubscriberId == ""
      && d.assignedSubscriberId == c.proposedSubscriberId
      && d.recoveryAuditId == projectId
      && d.financeReviewId == projectId
      && d.commissionAmount == c.commissionAmount
      && d.commissionVersion == c.commissionVersion
      && d.commissionCurrency == "EGP"
      && d.status == "completed"
      && d.completedBy == request.auth.uid
      && d.completedAt == request.time
      && d.keys().hasOnly([
       "projectDocId","merchantId","originalSubscriberId","previousSubscriberId",
       "assignedSubscriberId","recoveryAuditId","financeReviewId",
       "commissionAmount","commissionVersion","commissionCurrency",
       "status","completedBy","completedAt"
      ])
      && afterProject.assignmentStatus == "assigned_to_new_subscriber"
      && afterProject.assignedSubscriberId == d.assignedSubscriberId
      && afterProject.cutoverAt == request.time
      && afterCase.status == "cutover_completed"
      && afterCase.cutoverAt == request.time;
    }
    allow get, list: if isAdmin();
    // Missing records make validCutoverAuditCreate fail closed via get().
    // Duplicating exists()+get() for six records exhausts the batch's
    // expression budget during a valid three-document transfer.
    allow create: if isAdmin()
     && validCutoverAuditCreate(projectId);
    allow update, delete: if false;
   }

  match /merchantTransferFinanceReviews/{projectId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin()
    && projectExists(projectId)
    && request.resource.data.projectDocId == projectId
    && request.resource.data.adminUid == request.auth.uid
    && request.resource.data.reviewedAt == request.time
    && request.resource.data.currency == "EGP"
    && request.resource.data.formerSubscriberId == projectData(projectId).originalSubscriberId
    && request.resource.data.platformOutstandingAmount is number
    && request.resource.data.platformOutstandingAmount >= 0
    && request.resource.data.formerSubscriberOutstandingAmount is number
    && request.resource.data.formerSubscriberOutstandingAmount >= 0
    && request.resource.data.platformEarnedAmount is number
    && request.resource.data.platformEarnedAmount >= 0
    && request.resource.data.formerSubscriberEarnedAmount is number
    && request.resource.data.formerSubscriberEarnedAmount >= 0
    && request.resource.data.keys().hasOnly([
      "projectDocId","adminUid","reviewedAt","currency","formerSubscriberId",
      "platformOutstandingAmount","formerSubscriberOutstandingAmount",
      "platformEarnedAmount","formerSubscriberEarnedAmount"
    ])
    && exists(merchantTransferCasePath(projectId))
    && get(merchantTransferCasePath(projectId)).data.financeClearance == "pending"
    && get(merchantTransferCasePath(projectId)).data.operatorConsent == "accepted"
    && get(merchantTransferCasePath(projectId)).data.recipientConsent == "accepted"
    && getAfter(merchantTransferCasePath(projectId)).data.financeClearance == "reviewed"
    && getAfter(merchantTransferCasePath(projectId)).data.financeReviewedBy == request.auth.uid
    && getAfter(merchantTransferCasePath(projectId)).data.financeReviewedAt == request.time;
   allow update, delete: if false;
  }

  // C4B12 read access is already fenced; all state-changing writes stay
  // DENIED until a trusted billing gate and atomic v2 Rules are implemented.
  function validRepeatRecoveryWitness(cycleId){
   let d=request.resource.data;
   let p=get(projectPath(d.projectDocId)).data;
   let n=getAfter(projectPath(d.projectDocId)).data;
   let guard=get(billingGuardPath(p.assignedSubscriberId)).data;
   let priorId=p.cutoverAuditId;
   let previous=p.assignmentCycle;
   return d.cycle is int && d.cycle>=2
    && cycleId==d.projectDocId+"_"+string(d.cycle)
    && d.cycleId==cycleId
    && p.platformManaged==true
    && p.assignmentStatus=="assigned_to_new_subscriber"
    && p.assignedSubscriberId is string && p.assignedSubscriberId.size()>0
    && p.originalSubscriberId==d.originalSubscriberId
    && p.merchantId==d.merchantId
    && p.operatorId==d.projectDocId
    && d.previousSubscriberId==p.assignedSubscriberId
    && d.previousAssignmentAuditId==priorId
    && d.cycle==( ("assignmentCycle" in p) ? previous+1:2)
    && p.cutoverAuditId==(d.cycle==2?d.projectDocId:
       d.projectDocId+"_"+string(d.cycle-1))
    && guard.userId==p.assignedSubscriberId
    && guard.recoverySafe==true
    && guard.pendingPaymentId==""
    && guard.revision is int && guard.revision>0
    && d.reason in ["overdue_renewal","unpaid_first_month","confirmed_violation"]
    && d.evidenceReference is string && d.evidenceReference.size()>=8
    && d.evidenceReference.size()<=200
    && validVerifiedRecoveryCause(d.projectDocId,d.reason,d.evidenceReference)
    && d.status=="completed" && d.adminUid==request.auth.uid
    && d.recoveredAt==request.time
    && n.ownerId==p.ownerId && n.merchantId==p.merchantId
    && n.operatorId==p.operatorId
    && n.assignmentStatus=="platform_managed"
    && n.assignedSubscriberId==""
    && n.assignmentCycle==d.cycle
    && n.recoveryAuditId==cycleId
    && n.recoveryAt==request.time
    && n.recoveryAdminUid==request.auth.uid
    && getAfter(merchantHistoricGrantPath(d.projectDocId+"_"+p.assignedSubscriberId)).data.sourceRecoveryAuditId==cycleId
    && d.keys().hasOnly([
      "cycle","cycleId","projectDocId","merchantId","originalSubscriberId",
      "previousSubscriberId","previousAssignmentAuditId","reason",
      "evidenceReference","status","adminUid","recoveredAt"]);
  }
  function validRepeatHistoricGrant(grantId){
   let g=request.resource.data;
   let r=getAfter(merchantRecoveryCyclePath(g.sourceRecoveryAuditId)).data;
   let p=getAfter(projectPath(g.projectDocId)).data;
   return grantId==g.projectDocId+"_"+g.subscriberUid
    && g.subscriberUid is string && g.subscriberUid.size()>0
    && g.merchantId==p.merchantId
    && g.originalSubscriberId==p.originalSubscriberId
    && g.sourceRecoveryAuditId==g.projectDocId+"_"+string(g.firstRecoveredCycle)
    && g.firstRecoveredCycle is int && g.firstRecoveredCycle>=2
    && g.status=="historic_only" && g.grantedAt==request.time
    && r.status=="completed" && r.cycleId==g.sourceRecoveryAuditId
    && r.previousSubscriberId==g.subscriberUid
    && r.recoveredAt==request.time
    && p.recoveryAuditId==g.sourceRecoveryAuditId
    && p.assignmentCycle==g.firstRecoveredCycle
    && g.keys().hasOnly([
      "projectDocId","merchantId","subscriberUid","originalSubscriberId",
      "firstRecoveredCycle","sourceRecoveryAuditId","status","grantedAt"]);
  }
  match /merchantHistoricalAccess/{grantId} {
   allow get, list: if isAdmin()
    || (signedIn() && resource.data.subscriberUid==request.auth.uid);
   allow create: if isAdmin() && validRepeatHistoricGrant(grantId);
   allow update, delete: if false;
  }
  match /merchantRecoveryCycles/{cycleId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin() && validRepeatRecoveryWitness(cycleId);
   allow update, delete: if false;
  }
  function verifiedRepeatCycleTransferCreate(cycleId){
    let c=request.resource.data;
    let p=get(projectPath(c.projectDocId)).data;
    let op=get(operatorPath(c.projectDocId)).data;
    let ag=get(commissionAgreementPath(c.projectDocId)).data;
    return cycleId==c.projectDocId+"_"+string(c.cycle)
     && c.cycleId==cycleId && c.cycle is int && c.cycle>=2
     && p.assignmentCycle==c.cycle && p.recoveryAuditId==cycleId
     && p.platformManaged==true && p.assignmentStatus=="platform_managed"
     && p.assignedSubscriberId=="" && p.operatorId==c.projectDocId
     && c.merchantId==p.merchantId
     && c.originalSubscriberId==p.originalSubscriberId
     && c.previousSubscriberId==""
     && c.proposedSubscriberId is string && c.proposedSubscriberId.size()>0
     && c.proposedSubscriberId!=p.originalSubscriberId
     && !exists(merchantHistoricGrantPath(c.projectDocId+"_"+c.proposedSubscriberId))
     && subscriptionActive(c.proposedSubscriberId)
     && op.authUid is string && op.authUid.size()>0
     && op.isActive==true && op.status=="active" && op.agreementStatus=="accepted"
     && ag.status=="accepted" && ag.currency=="EGP"
     && c.commissionAmount==ag.currentAmount
     && c.commissionVersion==ag.acceptedVersion
     && c.commissionCurrency=="EGP"
     && c.status=="awaiting_consents"
     && c.operatorConsent=="pending" && c.recipientConsent=="pending"
     && c.operatorConsentedAt==null && c.recipientConsentedAt==null
     && c.financeClearance=="pending" && c.cutoverAt==null
     && c.reason is string && c.reason.size()>=15 && c.reason.size()<=300
     && c.createdAt==request.time && c.createdBy==request.auth.uid
     && c.keys().hasOnly([
      "cycle","cycleId","projectDocId","merchantId","originalSubscriberId",
      "previousSubscriberId","proposedSubscriberId","status",
      "operatorConsent","recipientConsent","operatorConsentedAt",
      "recipientConsentedAt","commissionAmount","commissionVersion",
      "commissionCurrency","financeClearance","cutoverAt",
      "reason","createdBy","createdAt"]);
  }
  match /merchantTransferCycles/{cycleId} {
   allow get: if isAdmin() || (signedIn() && (
     resource.data.proposedSubscriberId==request.auth.uid ||
     (operatorExists(resource.data.projectDocId)
      && operatorData(resource.data.projectDocId).authUid==request.auth.uid)));
   allow list: if isAdmin() || (signedIn() && resource.data.proposedSubscriberId==request.auth.uid);
   allow create: if isAdmin() && verifiedRepeatCycleTransferCreate(cycleId);
   allow update: if (
    signedIn() && resource.data.status=="awaiting_consents"
    && operatorExists(resource.data.projectDocId)
    && operatorData(resource.data.projectDocId).authUid==request.auth.uid
    && resource.data.operatorConsent=="pending"
    && request.resource.data.operatorConsent in ["accepted","declined"]
    && request.resource.data.operatorConsentedAt==request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
     "operatorConsent","operatorConsentedAt"])
   ) || (
    signedIn() && resource.data.status=="awaiting_consents"
    && resource.data.proposedSubscriberId==request.auth.uid
    && resource.data.recipientConsent=="pending"
    && request.resource.data.recipientConsent in ["accepted","declined"]
    && request.resource.data.recipientConsentedAt==request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
     "recipientConsent","recipientConsentedAt"])
   ) || (
    isAdmin() && resource.data.status=="awaiting_consents"
    && resource.data.operatorConsent=="accepted"
    && resource.data.recipientConsent=="accepted"
    && resource.data.financeClearance=="pending"
    && request.resource.data.financeClearance=="reviewed"
    && request.resource.data.financeReviewedAt==request.time
    && request.resource.data.financeReviewedBy==request.auth.uid
    && getAfter(/databases/$(database)/documents/merchantTransferCycleFinanceReviews/$(cycleId)).data.reviewedAt==request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
     "financeClearance","financeReviewedAt","financeReviewedBy"])
   ) || (
    isAdmin() && resource.data.status=="awaiting_consents"
    && resource.data.financeClearance=="reviewed"
    && resource.data.operatorConsent=="accepted"
    && resource.data.recipientConsent=="accepted"
    && subscriptionActive(resource.data.proposedSubscriberId)
    && request.resource.data.status=="cutover_completed"
    && request.resource.data.cutoverAt==request.time
    && request.resource.data.cutoverBy==request.auth.uid
    && request.resource.data.cutoverAuditId==cycleId
    && getAfter(merchantAssignmentCyclePath(cycleId)).data.status=="completed"
    && getAfter(projectPath(resource.data.projectDocId)).data.assignedSubscriberId==resource.data.proposedSubscriberId
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
     "status","cutoverAt","cutoverBy","cutoverAuditId"])
   );
   allow delete: if false;
  }
  function verifiedRepeatFinanceReview(cycleId){
    let d=request.resource.data;
    let c=get(merchantTransferCyclePath(cycleId)).data;
    let next=getAfter(merchantTransferCyclePath(cycleId)).data;
    let recovery=get(merchantRecoveryCyclePath(cycleId)).data;
    return d.cycleId==cycleId && d.projectDocId==c.projectDocId
     && d.adminUid==request.auth.uid
     && d.reviewedAt==request.time && d.currency=="EGP"
     && d.formerSubscriberId==recovery.previousSubscriberId
     && c.status=="awaiting_consents"
     && c.operatorConsent=="accepted" && c.recipientConsent=="accepted"
     && c.financeClearance=="pending"
     && next.financeClearance=="reviewed"
     && next.financeReviewedBy==request.auth.uid
     && next.financeReviewedAt==request.time
     && d.formerSubscriberEarnedAmount is number && d.formerSubscriberEarnedAmount>=0
     && d.formerSubscriberOutstandingAmount is number && d.formerSubscriberOutstandingAmount>=0
     && d.formerSubscriberOutstandingAmount<=d.formerSubscriberEarnedAmount
     && d.platformEarnedAmount is number && d.platformEarnedAmount>=0
     && d.platformOutstandingAmount is number && d.platformOutstandingAmount>=0
     && d.platformOutstandingAmount<=d.platformEarnedAmount
     && d.keys().hasOnly([
      "cycleId","projectDocId","adminUid","reviewedAt","currency",
      "formerSubscriberId","formerSubscriberEarnedAmount",
      "formerSubscriberOutstandingAmount","platformEarnedAmount",
      "platformOutstandingAmount"]);
  }
  match /merchantTransferCycleFinanceReviews/{cycleId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin() && verifiedRepeatFinanceReview(cycleId);
   allow update, delete: if false;
  }
  function verifiedRepeatAssignmentWitness(cycleId){
    let d=request.resource.data;
    let p=get(projectPath(d.projectDocId)).data;
    let c=get(merchantTransferCyclePath(cycleId)).data;
    let review=get(merchantTransferCycleFinanceReviewPath(cycleId)).data;
    let ag=get(commissionAgreementPath(d.projectDocId)).data;
    let updated=getAfter(projectPath(d.projectDocId)).data;
    return d.cycleId==cycleId && d.cycle is int && d.cycle>=2
     && cycleId==d.projectDocId+"_"+string(d.cycle)
     && p.assignmentCycle==d.cycle && p.recoveryAuditId==cycleId
     && p.platformManaged==true && p.assignmentStatus=="platform_managed"
     && p.assignedSubscriberId==""
     && d.projectDocId==c.projectDocId && d.merchantId==p.merchantId
     && d.originalSubscriberId==p.originalSubscriberId
     && d.previousSubscriberId==get(merchantRecoveryCyclePath(cycleId)).data.previousSubscriberId
     && c.status=="awaiting_consents" && c.financeClearance=="reviewed"
     && c.operatorConsent=="accepted" && c.recipientConsent=="accepted"
     && d.assignedSubscriberId==c.proposedSubscriberId
     && subscriptionActive(d.assignedSubscriberId)
     && !exists(merchantHistoricGrantPath(d.projectDocId+"_"+d.assignedSubscriberId))
     && review.reviewedAt==c.financeReviewedAt
     && review.adminUid==c.financeReviewedBy
     && review.cycleId==cycleId
     && ag.status=="accepted" && ag.currency=="EGP"
     && ag.currentAmount==c.commissionAmount
     && ag.acceptedVersion==c.commissionVersion
     && d.recoveryAuditId==cycleId && d.financeReviewId==cycleId
     && d.commissionAmount==c.commissionAmount
     && d.commissionVersion==c.commissionVersion
     && d.commissionCurrency=="EGP"
     && d.status=="completed" && d.completedAt==request.time
     && d.completedBy==request.auth.uid
     && updated.cutoverAuditId==cycleId
     && updated.assignmentStatus=="assigned_to_new_subscriber"
     && updated.assignedSubscriberId==d.assignedSubscriberId
     && updated.cutoverAt==request.time
     && getAfter(merchantTransferCyclePath(cycleId)).data.status=="cutover_completed"
     && d.keys().hasOnly([
      "cycle","cycleId","projectDocId","merchantId","originalSubscriberId",
      "previousSubscriberId","assignedSubscriberId","recoveryAuditId","financeReviewId",
      "commissionAmount","commissionVersion","commissionCurrency",
      "status","completedBy","completedAt"]);
  }
  match /merchantAssignmentCycles/{cycleId} {
   allow get, list: if isAdmin();
   allow create: if isAdmin() && verifiedRepeatAssignmentWitness(cycleId);
   allow update, delete: if false;
  }


  match /{document=**} { allow read, write: if false; }
 }
}
